{
  "name": "euix-doctor",
  "displayName": "EUIX Doctor",
  "description": "Static semantic analysis for EUIX XML, HTML, and template files — diagnostics in the Problems panel",
  "version": "0.2.5",
  "publisher": "euix",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "euix",
    "xml",
    "declarative",
    "linter",
    "doctor"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:xml",
    "onLanguage:html",
    "workspaceContains:**/*.xml",
    "onCommand:euixDoctor.analyzeWorkspace",
    "onCommand:euixDoctor.analyzeFile",
    "onCommand:euixDoctor.runTests",
    "onCommand:euixDoctor.fixFile",
    "onCommand:euixDoctor.formatDocument"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "euixDoctor.analyzeWorkspace",
        "title": "EUIX Doctor: Analyze Workspace"
      },
      {
        "command": "euixDoctor.analyzeFile",
        "title": "EUIX Doctor: Analyze Current File"
      },
      {
        "command": "euixDoctor.runTests",
        "title": "EUIX Doctor: Run Safe Test Scenarios"
      },
      {
        "command": "euixDoctor.fixFile",
        "title": "EUIX Doctor: Apply Auto-Fixes to Current File"
      },
      {
        "command": "euixDoctor.formatDocument",
        "title": "EUIX Doctor: Format Document"
      }
    ],
    "configuration": {
      "title": "EUIX Doctor",
      "properties": {
        "euixDoctor.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable EUIX Doctor diagnostics."
        },
        "euixDoctor.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-analyze the active EUIX file when it is saved."
        },
        "euixDoctor.runOnType": {
          "type": "boolean",
          "default": true,
          "description": "Re-analyze the active EUIX file while editing (debounced)."
        },
        "euixDoctor.runOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Analyze the workspace when it is opened."
        },
        "euixDoctor.debounceMs": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "Debounce delay (ms) before running analysis while typing."
        },
        "euixDoctor.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the built-in EUIX XML/HTML formatter."
        },
        "euixDoctor.format.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Indent width for the EUIX formatter."
        },
        "euixDoctor.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Format EUIX XML/HTML files when saved (before re-analysis)."
        },
        "euixDoctor.includePatterns": {
          "type": "array",
          "default": [
            "**/*.xml",
            "**/*.html",
            "**/*.htm"
          ],
          "description": "Glob patterns for files EUIX Doctor should analyze."
        },
        "euixDoctor.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show health score in the status bar after analysis."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --packages=bundle --sourcemap",
    "prepublishOnly": "npm run build",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --packages=bundle --sourcemap --watch",
    "package:vsix": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litepacks/euix.git",
    "directory": "packages/vscode-euix-doctor"
  }
}
