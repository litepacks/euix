{
  "name": "@euix/doctor",
  "version": "0.2.0",
  "description": "EUIX Doctor — semantic application analysis, behavior graph, and safe test generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "euix-doctor": "./bin/euix-doctor.js",
    "euix-doctor-analyze": "./bin/euix-doctor-analyze.js",
    "euix-doctor-format": "./bin/euix-doctor-format.js",
    "euix-doctor-watch": "./bin/euix-doctor-watch.js",
    "euix-doctor-pre-commit": "./bin/euix-doctor-pre-commit.js",
    "doctor": "./bin/euix-doctor.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "import": "./dist/cli/main.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "htmlparser2": "^9.1.0",
    "oxc-parser": "^0.149.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litepacks/euix.git",
    "directory": "packages/doctor"
  }
}
