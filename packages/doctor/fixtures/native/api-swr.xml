<uid_spec>
  <data_model>
    <state id="searchQuery" type="string">euix</state>
    <state id="repositories" type="array">[]</state>
    <state id="isLoading" type="boolean">false</state>
    <state id="errorMessage" type="string"></state>
  </data_model>

  <api_config base_url="https://api.github.com">
    <api_endpoint
      id="search_repos"
      tag="search_repos"
      url="/search/repositories?q={data.searchQuery}"
      method="GET"
      bind_target="repositories"
      select="items"
      loading="isLoading"
      error="errorMessage"
      auto_fetch="false"
      persist="localStorage"
    />
  </api_config>

  <flex direction="column" gap="12">
    <input bind="searchQuery" placeholder="Search repos" />
    <button id="btn-search">
      <on_click action="REVALIDATE_API" tag="search_repos" />
      Search
    </button>
    <div if="{data.isLoading}">Loading...</div>
    <div if="{data.errorMessage}">{data.errorMessage}</div>
    <for_each items="{data.repositories}" var="repo" key="id">
      <card>{repo.name}</card>
    </for_each>
  </flex>
</uid_spec>
