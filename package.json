{
  "name": "euixjs",
  "version": "0.0.5",
  "description": "EUIX Engine - Ultra-lightweight declarative HTML & XML framework",
  "type": "module",
  "main": "dist/EUIXEngine.umd.js",
  "module": "dist/EUIXEngine.es.js",
  "files": [
    "dist",
    "src",
    "components",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.devtools.config.js",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run --exclude tests/benchmark.test.js --exclude tests/memory.test.js",
    "test:parallel": "vitest run --fileParallelism=true --maxConcurrency=10 --exclude tests/benchmark.test.js --exclude tests/memory.test.js",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "vitest bench"
  },
  "keywords": [
    "euix",
    "declarative-ui",
    "xml",
    "vanilla-js",
    "fine-grained-reactivity"
  ],
  "homepage": "https://litepacks.github.io/euix/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litepacks/euix.git"
  },
  "bugs": {
    "url": "https://github.com/litepacks/euix/issues"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^27.0.1",
    "terser": "^5.49.2",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
