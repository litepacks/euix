{
  "name": "euixjs",
  "version": "0.2.4",
  "description": "EUIX Engine - Ultra-lightweight declarative HTML & XML framework",
  "type": "module",
  "main": "dist/EUIXEngine.umd.js",
  "module": "dist/EUIXEngine.es.js",
  "exports": {
    ".": {
      "import": "./dist/EUIXEngine.es.js",
      "require": "./dist/EUIXEngine.umd.js"
    },
    "./core": {
      "import": "./dist/EUIXEngineCore.es.js",
      "require": "./dist/EUIXEngineCore.umd.js"
    },
    "./api": {
      "import": "./dist/plugins/EUIXApiPlugin.es.js"
    },
    "./composer": {
      "import": "./dist/plugins/EUIXComposerPlugin.es.js"
    },
    "./dnd": {
      "import": "./dist/plugins/EUIXDragDropPlugin.es.js"
    },
    "./storage": {
      "import": "./dist/plugins/EUIXStoragePlugin.es.js"
    },
    "./collapse": {
      "import": "./dist/plugins/EUIXCollapsePlugin.es.js"
    },
    "./dialog": {
      "import": "./dist/plugins/EUIXDialogPlugin.es.js"
    },
    "./resilience": {
      "import": "./dist/plugins/EUIXResiliencePlugin.es.js"
    },
    "./reactive": {
      "import": "./dist/plugins/EUIXReactivePlugin.es.js"
    },
    "./animation": {
      "import": "./dist/plugins/EUIXAnimationPlugin.es.js"
    },
    "./devtools": {
      "import": "./dist/EUIXDevTools.es.js",
      "require": "./dist/EUIXDevTools.umd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "components",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.core.config.js && vite build --config vite.plugins.config.js && vite build --config vite.devtools.config.js",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/benchmark.test.js",
    "test:fast": "vitest run --exclude tests/benchmark.test.js --exclude tests/memory.test.js --exclude tests/torture/**",
    "test:parallel": "vitest run --fileParallelism=true --maxConcurrency=10 --exclude tests/benchmark.test.js",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:battle": "vitest run tests/property tests/fuzz tests/roundtrip tests/permutations tests/chaos tests/torture",
    "test:browser": "playwright test",
    "test:e2e": "playwright test",
    "test:soak": "vitest run tests/torture/soak.test.js",
    "test:mutation": "stryker run",
    "test:package": "node scripts/validate-package.js",
    "verify:release": "node scripts/verify-release.js",
    "bench": "vitest bench"
  },
  "keywords": [
    "euix",
    "declarative-ui",
    "xml",
    "vanilla-js",
    "fine-grained-reactivity"
  ],
  "homepage": "https://litepacks.github.io/euix/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litepacks/euix.git"
  },
  "bugs": {
    "url": "https://github.com/litepacks/euix/issues"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.9.0",
    "jsdom": "^27.0.1",
    "terser": "^5.49.2",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
