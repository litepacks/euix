{
  "name": "euix",
  "version": "1.0.0",
  "description": "EUIX Engine - Ultra-lightweight declarative HTML & XML framework",
  "type": "module",
  "main": "src/EUIXEngine.js",
  "module": "dist/EUIXEngine.es.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.devtools.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run --exclude tests/benchmark.test.js --exclude tests/memory.test.js",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "vitest bench"
  },
  "keywords": [
    "euix",
    "declarative-ui",
    "xml",
    "vanilla-js",
    "fine-grained-reactivity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-legacy": "^5.4.3",
    "jsdom": "^27.0.1",
    "terser": "^5.49.2",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
