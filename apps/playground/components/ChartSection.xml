<component_def name="chart-section">
    <data_model>
        <state id="selected_label">None</state>
        <state id="selected_value">None</state>
        <state id="selected_chart">None</state>
        <state id="chart_type">bar</state>
        <state id="exported_image"></state>

        <!-- Multi-Dataset Revenue & Expenses Chart Config -->
        <state id="finance_chart" type="object">
            {
                "type": "bar",
                "data": {
                    "labels": ["Jan", "Feb", "Mar", "Apr", "May", "Jun"],
                    "datasets": [
                        {
                            "label": "Revenue ($k)",
                            "data": [45, 52, 68, 74, 85, 96],
                            "backgroundColor": "rgba(99, 102, 241, 0.8)",
                            "borderColor": "rgb(99, 102, 241)",
                            "borderWidth": 2,
                            "borderRadius": 8
                        },
                        {
                            "label": "Expenses ($k)",
                            "data": [28, 32, 40, 42, 48, 51],
                            "backgroundColor": "rgba(244, 63, 94, 0.8)",
                            "borderColor": "rgb(244, 63, 94)",
                            "borderWidth": 2,
                            "borderRadius": 8
                        }
                    ]
                },
                "options": {
                    "responsive": true,
                    "maintainAspectRatio": false,
                    "plugins": {
                        "legend": { "labels": { "color": "#94a3b8" } }
                    },
                    "scales": {
                        "x": { "grid": { "color": "rgba(255, 255, 255, 0.05)" }, "ticks": { "color": "#94a3b8" } },
                        "y": { "grid": { "color": "rgba(255, 255, 255, 0.05)" }, "ticks": { "color": "#94a3b8" } }
                    }
                }
            }
        </state>

        <!-- Doughnut Distribution Chart Config -->
        <state id="device_distribution_chart" type="object">
            {
                "type": "doughnut",
                "data": {
                    "labels": ["Desktop", "Mobile", "Tablet", "Other"],
                    "datasets": [
                        {
                            "data": [55, 30, 10, 5],
                            "backgroundColor": [
                                "rgba(99, 102, 241, 0.85)",
                                "rgba(6, 182, 212, 0.85)",
                                "rgba(245, 158, 11, 0.85)",
                                "rgba(100, 116, 139, 0.85)"
                            ],
                            "borderColor": "#0f172a",
                            "borderWidth": 3
                        }
                    ]
                },
                "options": {
                    "responsive": true,
                    "maintainAspectRatio": false,
                    "plugins": {
                        "legend": { "position": "bottom", "labels": { "color": "#94a3b8" } }
                    }
                }
            }
        </state>

        <!-- Traffic Trends Area Line Chart Config -->
        <state id="traffic_chart" type="object">
            {
                "type": "line",
                "data": {
                    "labels": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
                    "datasets": [
                        {
                            "label": "Daily Active Users",
                            "data": [1200, 1900, 3000, 5000, 4200, 6100, 7400],
                            "borderColor": "rgb(16, 185, 129)",
                            "backgroundColor": "rgba(16, 185, 129, 0.15)",
                            "fill": true,
                            "tension": 0.4,
                            "pointBackgroundColor": "rgb(16, 185, 129)",
                            "pointRadius": 4
                        }
                    ]
                },
                "options": {
                    "responsive": true,
                    "maintainAspectRatio": false,
                    "plugins": {
                        "legend": { "labels": { "color": "#94a3b8" } }
                    },
                    "scales": {
                        "x": { "grid": { "color": "rgba(255, 255, 255, 0.05)" }, "ticks": { "color": "#94a3b8" } },
                        "y": { "grid": { "color": "rgba(255, 255, 255, 0.05)" }, "ticks": { "color": "#94a3b8" } }
                    }
                }
            }
        </state>
    </data_model>

    <flex direction="column" gap="24" class="w-full">
        <!-- Hero Header -->
        <flex class="p-6 sm:p-8 bg-slate-900/90 border border-slate-800 rounded-3xl shadow-xl flex-col sm:flex-row gap-6 items-start sm:items-center justify-between">
            <flex direction="column" gap="4">
                <flex direction="row" align="center" gap="8" class="flex-wrap">
                    <span class="px-3 py-1 bg-indigo-500/15 text-indigo-400 font-extrabold text-xs rounded-full border border-indigo-500/20 uppercase tracking-wider">
                        📊 Chart.js v4 Integration
                    </span>
                    <span class="text-xs text-slate-400 font-medium">Fine-Grained Reactive Visualizations</span>
                </flex>
                <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Declarative XML Charts &amp; Analytics</h1>
                <p class="text-xs sm:text-sm text-slate-400 max-w-2xl">
                    Render interactive canvas visualizations using &lt;chart&gt; XML tags with dynamic event binding, data toggling, and client-side PNG snapshot exports.
                </p>
            </flex>

            <!-- Selected Data Point Monitor -->
            <flex direction="column" gap="2" class="p-4 bg-slate-950/80 rounded-2xl border border-slate-800 shrink-0 min-w-[220px]">
                <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400">⚡ Click Inspector</span>
                <span class="text-xs font-semibold text-indigo-400">Chart: {data.selected_chart}</span>
                <span class="text-sm font-black text-white">Item: {data.selected_label}</span>
                <span class="text-xs font-bold text-emerald-400">Value: {data.selected_value}</span>
            </flex>
        </flex>

        <!-- Charts Grid 1: Finance Bar + Distribution Donut -->
        <grid class="grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Multi-Dataset Bar Chart (2 cols) -->
            <flex direction="column" gap="16" class="lg:col-span-2 bg-slate-900/80 backdrop-blur-md p-6 rounded-3xl border border-slate-800 shadow-xl">
                <flex direction="row" align="center" justify="between" class="flex-wrap gap-2">
                    <flex direction="column" gap="2">
                        <span class="text-xs font-black uppercase tracking-widest text-indigo-400">💼 Financial Health</span>
                        <h2 class="text-lg font-bold text-white">Revenue vs Expenses (H1 2026)</h2>
                    </flex>
                    <flex direction="row" gap="8" class="flex-wrap">
                        <button class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-bold rounded-xl text-xs transition-all cursor-pointer shadow-lg shadow-indigo-600/20 border border-indigo-500/30 flex items-center gap-1.5">
                            <on_click action="CHART_EXPORT" chart="finance_performance_chart" target="data.exported_image" />
                            📸 Export Snapshot
                        </button>
                        <button class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 font-bold rounded-xl text-xs transition-all cursor-pointer border border-slate-700 flex items-center gap-1.5">
                            <on_click action="CHART_EXPORT" chart="finance_performance_chart" target="data.exported_image" download="true" filename="financial-report.png" />
                            💾 Download PNG
                        </button>
                    </flex>
                </flex>

                <chart
                    id="finance_performance_chart"
                    config="{data.finance_chart}"
                    height="280"
                    class="w-full"
                >
                    <on_chart_click action="RUN_SCRIPT">
                        if ($evt.detail &amp;&amp; $evt.detail.value != null) {
                            $data.selected_chart = "Finance Bar";
                            $data.selected_label = $evt.detail.label || "N/A";
                            $data.selected_value = "$" + $evt.detail.value + "k";
                        }
                    </on_chart_click>
                </chart>
            </flex>

            <!-- Distribution Donut Chart (1 col) -->
            <flex direction="column" gap="16" class="bg-slate-900/80 backdrop-blur-md p-6 rounded-3xl border border-slate-800 shadow-xl">
                <flex direction="column" gap="2">
                    <span class="text-xs font-black uppercase tracking-widest text-cyan-400">📱 Platform Traffic</span>
                    <h2 class="text-lg font-bold text-white">Device Breakdown</h2>
                </flex>

                <chart
                    id="device_distribution_chart"
                    config="{data.device_distribution_chart}"
                    height="240"
                    class="w-full"
                >
                    <on_chart_click action="RUN_SCRIPT">
                        if ($evt.detail &amp;&amp; $evt.detail.value != null) {
                            $data.selected_chart = "Device Donut";
                            $data.selected_label = $evt.detail.label || "N/A";
                            $data.selected_value = $evt.detail.value + "%";
                        }
                    </on_chart_click>
                </chart>

                <flex direction="row" gap="8" justify="center" class="flex-wrap">
                    <button class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 font-bold rounded-xl text-xs transition-all cursor-pointer border border-slate-700">
                        <on_click action="CHART_TOGGLE_DATA" chart="device_distribution_chart" data_index="0" />
                        Toggle Desktop
                    </button>
                    <button class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 font-bold rounded-xl text-xs transition-all cursor-pointer border border-slate-700">
                        <on_click action="CHART_TOGGLE_DATA" chart="device_distribution_chart" data_index="1" />
                        Toggle Mobile
                    </button>
                </flex>
            </flex>
        </grid>

        <!-- Charts Grid 2: Traffic Trends Area Chart + Image Export Preview -->
        <grid class="grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Smooth Line Area Chart (2 Cols) -->
            <flex direction="column" gap="16" class="lg:col-span-2 bg-slate-900/80 backdrop-blur-md p-6 rounded-3xl border border-slate-800 shadow-xl">
                <flex direction="row" align="center" justify="between" class="flex-wrap gap-2">
                    <flex direction="column" gap="2">
                        <span class="text-xs font-black uppercase tracking-widest text-emerald-400">📈 User Engagement</span>
                        <h2 class="text-lg font-bold text-white">Weekly Active Traffic Trends</h2>
                    </flex>

                    <flex direction="row" gap="8" class="flex-wrap">
                        <button class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 font-bold rounded-xl text-xs transition-all cursor-pointer border border-slate-700">
                            <on_click action="CHART_EXPORT" chart="traffic_trend_chart" target="data.exported_image" />
                            📸 Export Traffic PNG
                        </button>
                        <button class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 font-bold rounded-xl text-xs transition-all cursor-pointer border border-slate-700">
                            <on_click action="RUN_SCRIPT">
                                const newData = $data.traffic_chart.data.datasets[0].data.map(() => Math.floor(Math.random() * 4000) + 1000);
                                $data.traffic_chart.data.datasets[0].data = newData;
                                $data.traffic_chart = { ...$data.traffic_chart };
                            </on_click>
                            🎲 Randomize Data
                        </button>
                    </flex>
                </flex>

                <chart
                    id="traffic_trend_chart"
                    config="{data.traffic_chart}"
                    height="260"
                    class="w-full"
                >
                    <on_chart_click action="RUN_SCRIPT">
                        if ($evt.detail &amp;&amp; $evt.detail.value != null) {
                            $data.selected_chart = "Traffic Area";
                            $data.selected_label = $evt.detail.label || "N/A";
                            $data.selected_value = $evt.detail.value + " users";
                        }
                    </on_chart_click>
                </chart>
            </flex>

            <!-- Exported PNG Preview Card (1 Col) -->
            <flex direction="column" gap="12" class="bg-slate-900/80 backdrop-blur-md p-6 rounded-3xl border border-slate-800 shadow-xl">
                <flex direction="row" align="center" justify="between">
                    <span class="text-xs font-black uppercase tracking-widest text-amber-400">🖼️ Image Export Output</span>
                    <button class="text-[11px] text-slate-400 hover:text-rose-400 font-bold transition">
                        <on_click action="SET_STATE">
                            <path>data.exported_image</path>
                            <value>""</value>
                        </on_click>
                        Clear
                    </button>
                </flex>
                <h2 class="text-sm font-bold text-white">Live Base64 PNG Snapshot</h2>

                <div class="flex-1 min-h-[180px] bg-slate-950/70 rounded-2xl border border-slate-800 flex items-center justify-center p-4 overflow-hidden">
                    <if condition="{data.exported_image}">
                        <flex direction="column" align="center" gap="10" class="w-full">
                            <img src="{data.exported_image}" alt="Exported Chart" class="max-w-full max-h-[140px] object-contain rounded-lg shadow-lg border border-slate-700" />
                            <span class="text-[10px] text-emerald-400 font-mono font-bold">✓ Base64 PNG Generated Successfully</span>
                        </flex>
                    </if>
                    <if condition="!{data.exported_image}">
                        <span class="text-xs text-slate-500 font-medium text-center">
                            Click "Export Snapshot" on any chart above to generate an instant base64 snapshot.
                        </span>
                    </if>
                </div>
            </flex>
        </grid>
    </flex>
</component_def>
