<component_def name="playground-section">
    <data_model>
        <state id="counter_value" type="number">0</state>
        <state id="counter_open" type="boolean">true</state>
        <state id="confirm_modal_open" type="boolean">false</state>
        <state id="delete_modal_open" type="boolean">false</state>
        <state id="deleting_todo_id" type="string"></state>
    </data_model>

    <imports>
        <import name="app-header" src="components/AppHeader.xml" />
        <import name="webmcp-section" src="components/WebMCPSection.xml" />
        <import name="reactive-section" src="components/ReactiveSection.xml" />
        <import name="animation-section" src="components/AnimationSection.xml" />
        <import name="action-composer-section" src="components/ActionComposerSection.xml" />
        <import name="ecommerce-section" src="components/EcommerceSection.xml" />
        <import name="virtual-list-section" src="components/VirtualListSection.xml" />
        <import name="kanban-section" src="components/KanbanSection.xml" />
        <import name="crypto-portfolio-section" src="components/CryptoPortfolioSection.xml" />
        <import name="table-section" src="components/TableSection.xml" />
        <import name="counter-section" src="components/CounterSection.xml" />
        <import name="countdown-section" src="components/CountdownSection.xml" />
        <import name="persistence-section" src="components/PersistenceSection.xml" />
        <import name="api-client-section" src="components/ApiClientSection.xml" />
        <import name="todo-section" src="components/TodoSection.xml" />
        <import name="posts-crud-section" src="components/PostsCrudSection.xml" />
        <import name="pokemon-section" src="components/PokemonSection.xml" />
        <import name="form-section" src="components/FormSection.xml" />
        <import name="events-section" src="components/EventsSection.xml" />
        <import name="confirm-modal" src="components/ConfirmModal.xml" />
        <import name="state-bridge-badge" src="components/StateBridgeBadge.xml" />
    </imports>

    <flex direction="column" gap="20" class="w-full">
        <!-- Hero Header -->
        <flex class="p-6 sm:p-8 bg-slate-900/90 border border-slate-800 rounded-3xl shadow-xl flex-col sm:flex-row gap-6 items-start sm:items-center justify-between">
            <flex direction="column" gap="4">
                <flex direction="row" align="center" gap="8" class="flex-wrap">
                    <span class="px-3 py-1 bg-amber-500/15 text-amber-400 font-extrabold text-xs rounded-full border border-amber-500/20 uppercase tracking-wider">
                        🎮 Interactive Playground
                    </span>
                    <span class="text-xs text-slate-400 font-medium">AST Caching &amp; Batching Active</span>
                </flex>
                <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Full Interactive Component Suites</h1>
                <p class="text-xs sm:text-sm text-slate-400 max-w-2xl">
                    Explore real-world full-stack components built 100% with Vanilla .EUIX Engine.
                </p>
            </flex>

            <span class="px-3 py-1.5 rounded-xl bg-emerald-500/15 text-emerald-400 border border-emerald-500/20 text-xs font-bold font-mono">
                ● Live Reactive
            </span>
        </flex>

        <webmcp-section />
        <reactive-section />
        <animation-section />
        <action-composer-section />
        <ecommerce-section />
        <virtual-list-section />
        <kanban-section />
        <crypto-portfolio-section />
        <table-section />
        <counter-section />
        <countdown-section />
        <persistence-section />
        <api-client-section />
        <state-bridge-badge count="{data.counter_value}" />

        <todo-section />
        <posts-crud-section />
        <pokemon-section />
        <form-section />
        <events-section />
        <confirm-modal bind="data.confirm_modal_open" mode="clear" title="Clear All Tasks?" message="Are you sure you want to permanently delete all tasks?" confirm_text="Yes, Delete All" cancel_text="Cancel" />
        <confirm-modal bind="data.delete_modal_open" mode="remove" title="Delete Task?" message="Are you sure you want to remove this task?" confirm_text="Yes, Delete" cancel_text="Cancel" />
    </flex>
</component_def>
