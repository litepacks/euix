<component_def name="pokemon-card">
    <flex direction="column" align="center" gap="4" class="p-3 bg-slate-900/90 border border-slate-800 rounded-2xl hover:border-indigo-500/50 hover:bg-slate-900 hover:shadow-lg transition-all">
        <img src="{props.image}" alt="{props.name}" width="72" height="72" />
        <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wide">#{props.id}</span>
        <span class="text-xs font-black text-white capitalize -mt-1">{props.name}</span>
    </flex>
</component_def>
