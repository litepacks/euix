<component_def name="todo-section">
    <constants>
        <const id="quick_btn">px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl text-xs transition-colors cursor-pointer border border-slate-700</const>
        <const id="btn_primary">px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs transition-colors cursor-pointer shadow-lg shadow-indigo-600/20 shrink-0</const>
    </constants>
    <flex direction="column" gap="12" class="w-full bg-slate-900/90 border border-slate-800 p-4 sm:p-6 rounded-3xl shadow-xl mb-6">
        <!-- Header Bar -->
        <flex class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between w-full min-w-0">
            <flex direction="row" align="center" gap="12">
                <span class="text-3xl">📝</span>
                <flex direction="column">
                    <h2 class="font-extrabold text-white text-lg">Interactive Todo Manager</h2>
                    <span class="text-xs text-slate-400">Task additions, inline editing, array mutations &amp; quick actions</span>
                </flex>
            </flex>
            <flex direction="row" align="center" gap="8" class="flex-wrap">
                <span class="px-2.5 py-1 bg-indigo-500/20 text-indigo-300 font-extrabold text-xs rounded-xl border border-indigo-500/30 hidden sm:inline-block">📄 140 Lines XML</span>
                <button type="button" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl text-xs cursor-pointer transition-colors border border-slate-700 flex items-center gap-1">
                    <on_click action="SET_STATE">
                        <path>data.code_modal_title</path>
                        <value>Interactive Todo Manager (components/TodoSection.xml)</value>
                    </on_click>
                    <on_click action="SET_STATE">
                        <path>data.code_modal_lines</path>
                        <value>140</value>
                    </on_click>
                    <on_click action="XHR">
                        <method>GET</method>
                        <url>./components/TodoSection.xml</url>
                        <target>data.code_modal_content</target>
                    </on_click>
                    <on_click action="SET_STATE">
                        <path>data.code_modal_open</path>
                        <value>true</value>
                    </on_click>
                    🔍 View XML Code
                </button>
            </flex>
        </flex>

        <form class="flex flex-row gap-2">
            <on_submit action="MUTATE_STATE">
                <path>data.todos</path>
                <operation>PUSH</operation>
                <item text="{data.new_todo_input}" completed="false" />
            </on_submit>
            <input type="text" bind="data.new_todo_input" placeholder="Enter a new task..." class="flex-1 px-4 py-2 bg-slate-950/80 border border-slate-800 rounded-xl text-xs text-white focus:outline-none focus:border-indigo-500 transition-all" />
            <button type="submit" class="{const.btn_primary}">
                Add Task
            </button>
        </form>

        <flex direction="row" gap="8" align="center" justify="between" class="px-1">
            <flex direction="row" gap="6">
                <button class="{const.quick_btn}">
                    + Quick Task
                    <on_click action="MUTATE_STATE">
                        <path>data.todos</path>
                        <operation>PUSH</operation>
                        <item text="Quick Task {data.todos.length + 1}" completed="false" />
                    </on_click>
                </button>
                <button class="px-3 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-semibold rounded-xl text-xs transition-colors cursor-pointer border border-rose-500/20">
                    Clear All Tasks
                    <on_click action="SET_STATE">
                        <path>data.confirm_modal_open</path>
                        <value>true</value>
                    </on_click>
                </button>
            </flex>
        </flex>

        <collapse bind="data.todos_open" title="Todo List" class="border border-slate-800 rounded-2xl overflow-hidden shadow-sm bg-slate-950/80" header_class="w-full flex items-center justify-between p-4 bg-slate-900 border-none font-bold text-white hover:bg-slate-800/80 cursor-pointer text-sm" body_class="p-4 flex flex-col gap-2">
            <flex direction="column" gap="8">
                <for_each items="{data.todos}" var="todo">
                    <flex direction="row" align="center" justify="between" gap="8" class="p-3 bg-slate-900/90 hover:bg-slate-800/60 border border-slate-800 rounded-xl transition-all shadow-sm">
                        <if condition="{data.editing_id} == {todo.id}">
                            <input type="text" bind="data.edit_todo_input" placeholder="Edit task..." autofocus="true" class="flex-1 px-3 py-1.5 bg-slate-950 border border-slate-700 text-white rounded-lg text-xs focus:outline-none focus:border-indigo-500" />
                            <flex direction="row" gap="6">
                                <button class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-lg text-xs cursor-pointer shadow-sm">
                                    Save
                                    <on_click action="MUTATE_STATE">
                                        <path>data.todos</path>
                                        <operation>UPDATE</operation>
                                        <where field="id" equals="{todo.id}" />
                                        <fields text="{data.edit_todo_input}" />
                                    </on_click>
                                </button>
                                <button class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-lg text-xs cursor-pointer border border-slate-700">
                                    Cancel
                                    <on_click action="SET_STATE">
                                        <path>data.editing_id</path>
                                        <value></value>
                                    </on_click>
                                    <on_click action="SET_STATE">
                                        <path>data.edit_todo_input</path>
                                        <value></value>
                                    </on_click>
                                </button>
                            </flex>
                            <else>
                                <input type="checkbox" bind="todo.completed" class="w-4 h-4 rounded border-slate-700 bg-slate-800 text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-500" />
                                <if condition="{todo.completed} == true">
                                    <span class="flex-1 text-xs text-slate-500 line-through pl-1">{todo.text}</span>
                                    <else>
                                        <span class="flex-1 text-xs text-slate-200 font-medium pl-1">{todo.text}</span>
                                    </else>
                                </if>
                                <flex direction="row" gap="6">
                                    <button class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-semibold rounded-lg text-xs transition-colors cursor-pointer">
                                        Edit
                                        <on_click action="SET_STATE">
                                            <path>data.editing_id</path>
                                            <value>{todo.id}</value>
                                        </on_click>
                                        <on_click action="SET_STATE">
                                            <path>data.edit_todo_input</path>
                                            <value>{todo.text}</value>
                                            <focus>data.edit_todo_input</focus>
                                        </on_click>
                                    </button>
                                    <button class="px-2.5 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-semibold rounded-lg text-xs transition-colors cursor-pointer border border-rose-500/20">
                                        Delete
                                        <on_click action="SET_STATE">
                                            <path>data.selected_todo_id</path>
                                            <value>{todo.id}</value>
                                        </on_click>
                                        <on_click action="SET_STATE">
                                            <path>data.delete_modal_open</path>
                                            <value>true</value>
                                        </on_click>
                                    </button>
                                </flex>
                            </else>
                        </if>
                    </flex>
                </for_each>
            </flex>
        </collapse>
    </flex>
</component_def>