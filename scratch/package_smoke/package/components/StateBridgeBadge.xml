<component_def name="state-bridge-badge">
    <flex direction="row" align="center" justify="between" class="w-full p-3 bg-indigo-50/80 border border-indigo-100 rounded-xl">
        <flex direction="row" align="center" gap="8">
            <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
            <span class="text-xs font-bold text-indigo-900">Child Component Parent State Bridge</span>
        </flex>
        <flex direction="row" align="center" gap="12">
            <span class="text-xs font-semibold text-indigo-700">Prop State: <strong class="font-mono text-indigo-950">{props.count}</strong></span>
            <span class="text-xs font-semibold text-slate-600">Direct Parent Access: <strong class="font-mono text-slate-900">{parent.data.counter_value}</strong></span>
        </flex>
    </flex>
</component_def>
