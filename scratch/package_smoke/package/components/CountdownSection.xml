<component_def name="countdown-section">
    <data_model>
        <state id="timer_seconds">60</state>
        <state id="timer_status">Active (1s Tick)</state>
    </data_model>

    <flex direction="column" gap="16" class="w-full bg-white p-3.5 sm:p-5 md:p-6 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 mb-6">
        <flex direction="row" align="center" justify="between" class="border-b border-slate-100 pb-3">
            <flex direction="row" align="center" gap="8">
                <span class="text-xl">⏱️</span>
                <flex direction="column">
                    <h2 class="font-extrabold text-slate-800 text-base">Live Countdown Timer Demo (&lt;on_interval&gt;)</h2>
                    <span class="text-xs text-slate-500">Declarative 1-second interval timer hook with auto-cleanup</span>
                </flex>
            </flex>
            <span class="px-2.5 py-1 bg-amber-50 text-amber-700 font-bold rounded-lg text-xs border border-amber-200/60 font-mono">
                Status: {data.timer_status}
            </span>
        </flex>

        <flex direction="column" align="center" gap="12" class="bg-slate-50 p-6 rounded-xl border border-slate-100">
            <!-- Declarative 1-second recurring interval hook with condition -->
            <on_interval ms="1000" if="{data.timer_seconds} &gt; 0" action="SET_STATE">
                <path>data.timer_seconds</path>
                <value>{data.timer_seconds} - 1</value>
            </on_interval>

            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Remaining Time</span>
            <span class="text-5xl font-black text-amber-600 font-mono tracking-tight bg-amber-50 px-6 py-3 rounded-2xl border border-amber-200/60 shadow-inner">
                {data.timer_seconds}s
            </span>

            <flex direction="row" gap="8" class="mt-2">
                <button class="px-3.5 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg text-xs transition-colors cursor-pointer flex items-center gap-1">
                    <on_click action="SET_STATE">
                        <path>data.timer_seconds</path>
                        <value>60</value>
                    </on_click>
                    🔄 Reset (60s)
                </button>
                <button class="px-3.5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-lg text-xs transition-colors cursor-pointer">
                    <on_click action="SET_STATE">
                        <path>data.timer_seconds</path>
                        <value>30</value>
                    </on_click>
                    ⚡ Set 30s
                </button>
                <button class="px-3.5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-lg text-xs transition-colors cursor-pointer">
                    <on_click action="SET_STATE">
                        <path>data.timer_seconds</path>
                        <value>10</value>
                    </on_click>
                    🚀 Set 10s
                </button>
            </flex>
        </flex>
    </flex>
</component_def>
