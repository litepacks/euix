<component_def name="posts-crud-section">
    <collapse bind="data.posts_open" title="📡 Declarative Posts CRUD (JSONPlaceholder REST API)" class="border border-slate-200/80 rounded-xl overflow-hidden shadow-sm" header_class="w-full flex items-center justify-between p-4 bg-slate-50/70 border-none font-bold text-slate-700 hover:bg-slate-50 cursor-pointer text-sm" body_class="p-4 flex flex-col gap-4">
        
        <!-- Header & Action Info -->
        <flex class="pb-3 border-b border-slate-100 flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between w-full min-w-0">
            <flex direction="column">
                <span class="text-xs font-bold text-slate-700">JSONPlaceholder REST API Endpoints</span>
                <span class="text-[11px] text-slate-500">GET, POST, DELETE https://jsonplaceholder.typicode.com/posts</span>
            </flex>
            <button class="px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs rounded-lg transition-colors cursor-pointer flex items-center gap-1.5">
                <span>🔄 Fetch Initial Posts</span>
                <on_click action="XHR">
                    <method>GET</method>
                    <url>https://jsonplaceholder.typicode.com/posts?_limit=4</url>
                    <target>data.posts</target>
                    <loading>data.posts_loading</loading>
                    <error>data.posts_error</error>
                </on_click>
            </button>
        </flex>

        <!-- New Post Form (POST Endpoint) -->
        <form class="p-3.5 bg-slate-50/80 border border-slate-200/70 rounded-xl flex flex-col gap-2.5">
            <on_submit action="XHR">
                <method>POST</method>
                <url>https://jsonplaceholder.typicode.com/posts</url>
                <header name="Content-type">application/json; charset=UTF-8</header>
                <body>{"title": "{data.new_post_title}", "body": "{data.new_post_body}", "userId": 1}</body>
                <target>data.posts</target>
                <operation>UNSHIFT</operation>
                <loading>data.posts_loading</loading>
                <error>data.posts_error</error>
                <reset path="data.new_post_title" />
                <reset path="data.new_post_body" />
            </on_submit>

            <span class="text-xs font-black text-slate-700">➕ Create New Post (POST /posts)</span>
            <input type="text" bind="data.new_post_title" placeholder="Post title..." class="w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
            <textarea bind="data.new_post_body" placeholder="Post body content..." rows="2" class="w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-blue-500/20 resize-none"></textarea>
            
            <flex direction="row" justify="end">
                <button type="submit" class="{const.btn_primary}">
                    <span>Publish Post</span>
                </button>
            </flex>
        </form>

        <!-- Loading / Error Indicators -->
        <if condition="{data.posts_loading} == true">
            <span class="text-xs text-blue-600 font-bold p-3 text-center">Fetching JSONPlaceholder API...</span>
        </if>
        <if condition="{data.posts_error} != ''">
            <span class="text-xs text-rose-600 font-bold p-3 text-center">Error: {data.posts_error}</span>
        </if>

        <!-- Dynamic Posts List (GET, DELETE Endpoints) -->
        <flex direction="column" gap="8">
            <for_each items="{data.posts}" var="post">
                <flex direction="row" justify="between" align="start" class="p-3 bg-white border border-slate-200/80 rounded-xl hover:border-slate-300 transition-all shadow-2xs">
                    <flex direction="column" gap="2" class="flex-1 pr-3">
                        <flex direction="row" align="center" gap="6">
                            <span class="px-2 py-0.5 bg-blue-50 text-blue-700 font-bold text-[10px] rounded-md">ID #{post.id}</span>
                            <span class="text-xs font-bold text-slate-800 capitalize">{post.title}</span>
                        </flex>
                        <span class="text-xs text-slate-600 leading-relaxed">{post.body}</span>
                    </flex>

                    <button class="px-2.5 py-1 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs rounded-lg transition-colors cursor-pointer shrink-0">
                        <span>🗑️ Delete</span>
                        <on_click action="XHR">
                            <method>DELETE</method>
                            <url>https://jsonplaceholder.typicode.com/posts/{post.id}</url>
                            <target>data.posts</target>
                            <operation>REMOVE</operation>
                            <where field="id" equals="{post.id}" />
                            <loading>data.posts_loading</loading>
                            <error>data.posts_error</error>
                        </on_click>
                    </button>
                </flex>
            </for_each>
        </flex>
    </collapse>
</component_def>
