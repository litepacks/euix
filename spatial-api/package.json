{
  "name": "euix-spatial-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker & D1 Spatial API for EUIX Engine Interactive Map Suite",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init:local": "wrangler d1 execute euix-spatial-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute euix-spatial-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^3.109.2"
  }
}
