<component_def name="pokemon-section">
    <collapse bind="data.pokemon_open" title="🌐 Async Declarative XHR (PokéAPI)" class="border border-slate-200/80 rounded-xl overflow-hidden shadow-sm" header_class="w-full flex items-center justify-between p-4 bg-slate-50/70 border-none font-bold text-slate-700 hover:bg-slate-50 cursor-pointer text-sm" body_class="p-4 flex flex-col gap-3">
        <flex direction="row" justify="between" align="center" class="pb-2 border-b border-slate-100">
            <span class="text-xs text-slate-500 font-medium">Fetches 12 Pokémon dynamically from PokéAPI</span>
            <button class="px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs rounded-lg transition-colors cursor-pointer flex items-center gap-1.5">
                <span>🔄 Reload Pokémon</span>
                <on_click action="XHR">
                    <method>GET</method>
                    <url>https://pokeapi.co/api/v2/pokemon?limit=12</url>
                    <select>results</select>
                    <target>data.pokemons</target>
                    <loading>data.pokemon_loading</loading>
                    <error>data.pokemon_error</error>
                    <item_map>
                        <field as="id" from="url" match="/(\d+)\/?$/" />
                        <field as="name" from="name" />
                        <field as="image" template="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/{id}.png" />
                    </item_map>
                </on_click>
            </button>
        </flex>

        <if condition="{data.pokemon_loading} == true">
            <span class="text-sm text-blue-600 font-medium p-4 text-center">Loading Pokémon from API...</span>
            <else>
                <if condition="{data.pokemon_error} != ''">
                    <span class="text-sm text-rose-600 font-medium p-4 text-center">Error: {data.pokemon_error}</span>
                    <else>
                        <grid cols="4" gap="8">
                            <for_each items="{data.pokemons}" var="poke">
                                <pokemon-card image="{poke.image}" name="{poke.name}" id="{poke.id}" />
                            </for_each>
                        </grid>
                    </else>
                </if>
            </else>
        </if>
    </collapse>
</component_def>