<component_def name="pokemon-section">
    <collapse bind="data.pokemon_open" title="🌐 Async Declarative XHR (PokéAPI)" class="border border-slate-800 rounded-2xl overflow-hidden shadow-sm bg-slate-950/80 mb-6" header_class="w-full flex items-center justify-between p-4 bg-slate-900 border-none font-bold text-white hover:bg-slate-800/80 cursor-pointer text-sm" body_class="p-4 sm:p-5 flex flex-col gap-4">
        <flex direction="row" justify="between" align="center" class="pb-3 border-b border-slate-800">
            <span class="text-xs text-slate-400 font-medium">Fetches 12 Pokémon dynamically from PokéAPI</span>
            <button class="px-3.5 py-1.5 bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 font-bold text-xs rounded-xl transition-colors cursor-pointer flex items-center gap-1.5 border border-indigo-500/30">
                <span>🔄 Reload Pokémon</span>
                <on_click action="XHR">
                    <method>GET</method>
                    <url>https://pokeapi.co/api/v2/pokemon?limit=12</url>
                    <select>results</select>
                    <target>data.pokemons</target>
                    <loading>data.pokemon_loading</loading>
                    <error>data.pokemon_error</error>
                    <item_map>
                        <field as="id" from="url" match="/(\d+)\/?$/" />
                        <field as="name" from="name" />
                        <field as="image" template="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/{id}.png" />
                    </item_map>
                </on_click>
            </button>
        </flex>

        <if condition="{data.pokemon_loading} == true">
            <span class="text-sm text-indigo-400 font-medium p-4 text-center">Loading Pokémon from API...</span>
            <else>
                <if condition="{data.pokemon_error} != ''">
                    <span class="text-sm text-rose-400 font-medium p-4 text-center">Error: {data.pokemon_error}</span>
                    <else>
                        <grid cols="4" gap="8" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <for_each items="{data.pokemons}" var="poke">
                                <pokemon-card image="{poke.image}" name="{poke.name}" id="{poke.id}" />
                            </for_each>
                        </grid>
                    </else>
                </if>
            </else>
        </if>
    </collapse>
</component_def>