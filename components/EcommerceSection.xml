<component_def name="ecommerce-section">
    <!-- Declarative External JS Script Loader (Canvas Confetti) -->
    <use_script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js" />

    <data_model>
        <state id="ecommerce_products" type="array"></state>
        <state id="ecommerce_loading" type="string">false</state>
        <state id="ecommerce_error" type="string"></state>
        <state id="cart_items" type="array"></state>
        <state id="cart_open" type="string">true</state>
        <state id="search_keyword" type="string"></state>
        <state id="selected_category" type="string">all</state>
    </data_model>

    <!-- XHR Data Hydration Hook -->
    <on_mount action="XHR">
        <method>GET</method>
        <url>https://dummyjson.com/products?limit=8</url>
        <select>products</select>
        <target>data.ecommerce_products</target>
        <loading>data.ecommerce_loading</loading>
        <error>data.ecommerce_error</error>
        <item_map>
            <field as="id" from="id" />
            <field as="title" from="title" />
            <field as="price" from="price" />
            <field as="category" from="category" />
            <field as="thumbnail" from="thumbnail" />
            <field as="rating" from="rating" />
        </item_map>
    </on_mount>

    <flex direction="column" gap="16" class="w-full bg-slate-900/90 border border-slate-800 p-4 sm:p-6 rounded-3xl shadow-xl mb-6">
        <!-- Header & Action Controls -->
        <flex class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between w-full min-w-0">
            <flex direction="row" align="center" gap="12">
                <span class="text-3xl">🛍️</span>
                <flex direction="column">
                    <h2 class="font-extrabold text-white text-lg">E-Commerce Catalog &amp; Interactive Cart</h2>
                    <span class="text-xs text-slate-400">XHR Products Fetch, SWR API Revalidation &amp; Fine-grained Cart Mutations</span>
                </flex>
            </flex>
            <flex direction="row" align="center" gap="8" class="flex-wrap">
                <span class="px-2.5 py-1 bg-indigo-500/20 text-indigo-300 font-extrabold text-xs rounded-xl border border-indigo-500/30 hidden sm:inline-block">📄 179 Lines XML</span>
                <button type="button" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl text-xs cursor-pointer transition-colors border border-slate-700 flex items-center gap-1">
                    <on_click action="SET_STATE">
                        <path>data.code_modal_title</path>
                        <value>E-Commerce Catalog &amp; Cart (components/EcommerceSection.xml)</value>
                    </on_click>
                    <on_click action="SET_STATE">
                        <path>data.code_modal_lines</path>
                        <value>179</value>
                    </on_click>
                    <on_click action="XHR">
                        <method>GET</method>
                        <url>./components/EcommerceSection.xml</url>
                        <target>data.code_modal_content</target>
                    </on_click>
                    <on_click action="SET_STATE">
                        <path>data.code_modal_open</path>
                        <value>true</value>
                    </on_click>
                    🔍 View XML Code
                </button>
                <button type="button" class="px-3 py-1.5 bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-300 font-bold rounded-xl text-xs border border-indigo-500/30 cursor-pointer transition-colors">
                    <on_click action="REVALIDATE_API">
                        <target>data.ecommerce_products</target>
                    </on_click>
                    🔄 Refresh Products
                </button>
            </flex>
        </flex>

        <!-- Shopping Cart Drawer / Panel -->
        <collapse bind="data.cart_open" title="🛒 Shopping Cart ({data.cart_items.length} items)" class="border border-slate-800 bg-slate-950/80 rounded-2xl overflow-hidden shadow-sm" header_class="w-full flex items-center justify-between p-3.5 bg-slate-900 font-bold text-indigo-300 cursor-pointer text-xs" body_class="p-4 flex flex-col gap-3">
            <if condition="{data.cart_items.length} == 0">
                <span class="text-xs text-slate-400 italic py-2 text-center">Your shopping cart is currently empty. Add some products below!</span>
            </if>

            <if condition="{data.cart_items.length} > 0">
                <flex direction="column" gap="8" class="w-full max-h-[220px] overflow-y-auto pr-1">
                    <for_each items="{data.cart_items}" var="item">
                        <flex direction="row" align="center" justify="between" class="p-2.5 bg-slate-900/90 rounded-xl border border-slate-800 shadow-sm text-xs gap-3">
                            <flex direction="row" align="center" gap="10" class="flex-1 min-w-0">
                                <img src="{item.thumbnail}" class="w-9 h-9 object-cover rounded-md border border-slate-800 shrink-0 bg-slate-950" alt="{item.title}" />
                                <flex direction="column" class="min-w-0">
                                    <flex direction="row" align="center" gap="6">
                                        <span class="font-bold text-white truncate">{item.title}</span>
                                        <span class="px-1.5 py-0.5 bg-indigo-500/20 text-indigo-300 font-black rounded text-[10px] shrink-0 border border-indigo-500/30">x{item.quantity}</span>
                                    </flex>
                                    <span class="text-[11px] text-emerald-400 font-extrabold">${item.price}</span>
                                </flex>
                            </flex>
                            <flex direction="row" align="center" gap="4" class="shrink-0">
                                <button type="button" class="w-6 h-6 flex items-center justify-center bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded cursor-pointer" title="Decrease Quantity">
                                    <on_click action="MUTATE_STATE" operation="DECREMENT">
                                        <path>data.cart_items</path>
                                        <index>{item._index}</index>
                                    </on_click>
                                    -
                                </button>
                                <button type="button" class="w-6 h-6 flex items-center justify-center bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded cursor-pointer" title="Increase Quantity">
                                    <on_click action="MUTATE_STATE" operation="INCREMENT">
                                        <path>data.cart_items</path>
                                        <index>{item._index}</index>
                                    </on_click>
                                    +
                                </button>
                                <button type="button" class="w-6 h-6 flex items-center justify-center bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-bold rounded cursor-pointer ml-1 border border-rose-500/20" title="Remove Item">
                                    <on_click action="MUTATE_STATE" operation="REMOVE">
                                        <path>data.cart_items</path>
                                        <index>{item._index}</index>
                                    </on_click>
                                    ✕
                                </button>
                            </flex>
                        </flex>
                    </for_each>
                </flex>

                <flex direction="row" align="center" justify="between" class="pt-3 border-t border-slate-800">
                    <span class="text-xs font-extrabold text-white">Cart Total Items: {data.cart_items.length}</span>
                    <flex direction="row" align="center" gap="8">
                        <button type="button" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded-xl text-xs cursor-pointer transition-colors">
                            <on_click action="MUTATE_STATE" operation="CLEAR">
                                <path>data.cart_items</path>
                            </on_click>
                            🧹 Clear Cart
                        </button>
                        <button type="button" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs cursor-pointer transition-colors shadow-sm">
                            <on_click action="RUN_SCRIPT">
                                if (window.confetti) window.confetti({ particleCount: 150, spread: 90, origin: { y: 0.6 } });
                            </on_click>
                            <on_click action="MUTATE_STATE" operation="CLEAR">
                                <path>data.cart_items</path>
                            </on_click>
                            🎉 Checkout &amp; Complete Order
                        </button>
                    </flex>
                </flex>
            </if>
        </collapse>

        <!-- Loading State -->
        <if condition="{data.ecommerce_loading} == 'true'">
            <flex direction="row" align="center" justify="center" gap="8" class="p-8 text-indigo-400 font-bold text-sm bg-slate-950/80 rounded-2xl border border-slate-800">
                <span class="animate-spin text-lg">🌀</span> Loading E-Commerce Catalog...
            </flex>
        </if>

        <!-- Products Grid (1 col on mobile, 2 on desktop) -->
        <grid cols="2" gap="12" class="w-full grid grid-cols-1 sm:grid-cols-2">
            <for_each items="{data.ecommerce_products}" var="product">
                <flex direction="column" justify="between" class="p-4 bg-slate-950/80 hover:bg-slate-900 rounded-2xl border border-slate-800 hover:border-indigo-500/40 shadow-sm hover:shadow-md transition-all gap-3">
                    <flex direction="column" gap="8">
                        <img src="{product.thumbnail}" class="w-full h-32 object-cover rounded-xl bg-slate-900 border border-slate-800" alt="{product.title}" />
                        <flex direction="column" gap="2">
                            <flex direction="row" align="center" justify="between">
                                <span class="px-2 py-0.5 bg-indigo-500/20 text-indigo-300 font-bold rounded text-[10px] uppercase tracking-wider border border-indigo-500/30">{product.category}</span>
                                <span class="text-xs font-extrabold text-amber-400">⭐ {product.rating}</span>
                            </flex>
                            <span class="text-xs font-bold text-white line-clamp-1">{product.title}</span>
                            <span class="text-sm font-black text-emerald-400">${product.price}</span>
                        </flex>
                    </flex>

                    <button type="button" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs transition-colors cursor-pointer flex items-center justify-center gap-1.5 shadow-sm shadow-indigo-600/20">
                        <on_click action="MUTATE_STATE" operation="PUSH">
                            <path>data.cart_items</path>
                            <where equals="{product.id}" />
                            <item id="{product.id}" title="{product.title}" price="{product.price}" thumbnail="{product.thumbnail}" quantity="1" />
                        </on_click>
                        🛒 Add to Cart
                    </button>
                </flex>
            </for_each>
        </grid>
    </flex>
</component_def>
