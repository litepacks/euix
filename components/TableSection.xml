<component_def name="table-section">
    <data_model>
        <state id="table_open" type="string">true</state>
        <state id="new_emp_name" type="string"></state>
        <state id="new_emp_role" type="string"></state>
        <state id="new_emp_dept" type="string"></state>
        <state id="employees" type="array">
            <item name="Ahmet Yilmaz" role="Lead Architect" dept="Core Runtime" status="Active" />
            <item name="Zeynep Kaya" role="UI Engineer" dept="Component DSL" status="Active" />
            <item name="Can Demir" role="QA Specialist" dept="Performance" status="Offline" />
        </state>
    </data_model>

    <constants>
        <const id="table_th">px-4 py-3.5 text-left text-xs font-bold text-slate-400 uppercase tracking-wider bg-slate-950 border-b border-slate-800</const>
        <const id="table_td">px-4 py-3.5 text-xs text-slate-300 border-b border-slate-800/70 align-middle</const>
        <const id="badge_active">px-2.5 py-1 bg-emerald-500/15 text-emerald-400 font-bold rounded-xl text-[11px] border border-emerald-500/20 inline-flex items-center gap-1</const>
        <const id="badge_offline">px-2.5 py-1 bg-slate-800 text-slate-400 font-bold rounded-xl text-[11px] border border-slate-700 inline-flex items-center gap-1</const>
    </constants>

    <collapse bind="data.table_open" title="📊 Data Table &amp; Employee Roster" class="border border-slate-800 rounded-2xl overflow-hidden shadow-sm bg-slate-950/80 mb-6" header_class="w-full flex items-center justify-between p-4 bg-slate-900 border-none font-bold text-white hover:bg-slate-800/80 cursor-pointer text-sm" body_class="p-4 sm:p-5 flex flex-col gap-4">
        <!-- Add New User Form Bar -->
        <flex direction="row" align="center" gap="8" wrap="true" class="w-full">
            <input type="text" placeholder="Employee Name" bind="data.new_emp_name" class="flex-1 min-w-[140px] px-3.5 py-2 text-xs bg-slate-900 border border-slate-800 text-white rounded-xl outline-none focus:border-indigo-500" />
            <input type="text" placeholder="Role (e.g. Architect)" bind="data.new_emp_role" class="flex-1 min-w-[120px] px-3.5 py-2 text-xs bg-slate-900 border border-slate-800 text-white rounded-xl outline-none focus:border-indigo-500" />
            <input type="text" placeholder="Dept (e.g. R&amp;D)" bind="data.new_emp_dept" class="flex-1 min-w-[100px] px-3.5 py-2 text-xs bg-slate-900 border border-slate-800 text-white rounded-xl outline-none focus:border-indigo-500" />
            <button class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition-colors cursor-pointer whitespace-nowrap shrink-0 shadow-lg shadow-indigo-600/20">
                <on_click action="MUTATE_STATE" operation="PUSH">
                    <path>data.employees</path>
                    <value name="{data.new_emp_name}" role="{data.new_emp_role}" dept="{data.new_emp_dept}" status="Active" />
                </on_click>
                <on_click action="SET_STATE">
                    <path>data.new_emp_name</path>
                    <value></value>
                </on_click>
                <on_click action="SET_STATE">
                    <path>data.new_emp_role</path>
                    <value></value>
                </on_click>
                <on_click action="SET_STATE">
                    <path>data.new_emp_dept</path>
                    <value></value>
                </on_click>
                ➕ Add Employee
            </button>
        </flex>

        <!-- Data Table -->
        <div class="w-full overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/90 shadow-sm">
            <table class="w-full border-collapse text-left">
                <thead>
                    <tr>
                        <th class="{const.table_th}">#</th>
                        <th class="{const.table_th}">Employee Name</th>
                        <th class="{const.table_th}">Role</th>
                        <th class="{const.table_th}">Department</th>
                        <th class="{const.table_th}">Status</th>
                        <th class="{const.table_th} text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <for_each items="{data.employees}" var="emp">
                        <tr class="hover:bg-slate-800/60 transition-colors">
                            <td class="{const.table_td} font-mono font-bold text-slate-500">#{emp._index + 1}</td>
                            <td class="{const.table_td} font-bold text-white">{emp.name}</td>
                            <td class="{const.table_td} text-slate-300">{emp.role}</td>
                            <td class="{const.table_td}"><span class="px-2 py-0.5 bg-slate-800 text-slate-300 rounded-lg text-[11px] font-semibold border border-slate-700">{emp.dept}</span></td>
                            <td class="{const.table_td}">
                                <if condition="{emp.status} == 'Active'">
                                    <span class="{const.badge_active}"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>Active</span>
                                </if>
                                <if condition="{emp.status} != 'Active'">
                                    <span class="{const.badge_offline}">Offline</span>
                                </if>
                            </td>
                            <td class="{const.table_td} text-right">
                                <button class="px-2.5 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-bold text-[11px] rounded-lg transition-colors cursor-pointer border border-rose-500/20">
                                    <on_click action="MUTATE_STATE" operation="REMOVE">
                                        <path>data.employees</path>
                                        <index>{emp._index}</index>
                                    </on_click>
                                    Remove
                                </button>
                            </td>
                        </tr>
                    </for_each>
                </tbody>
            </table>
        </div>
    </collapse>
</component_def>
