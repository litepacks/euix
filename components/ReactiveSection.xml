<component_def name="reactive-section">
    <data_model>
        <state id="reactive_open" type="string">true</state>
        <state id="user_first_name" type="string">Alex</state>
        <state id="user_last_name" type="string">Morgan</state>
        <state id="item_quantity" type="number">3</state>
        <state id="unit_price" type="number">29.99</state>
        <state id="reactive_log" type="string">Watchers ready...</state>

        <computed id="display_full_name" deps="user_first_name, user_last_name">
            return ($data.user_first_name || '') + ' ' + ($data.user_last_name || '');
        </computed>

        <computed id="calculated_total_price" deps="item_quantity, unit_price">
            var qty = Number($data.item_quantity) || 0;
            var price = Number($data.unit_price) || 0;
            return (qty * price).toFixed(2);
        </computed>
    </data_model>

    <watch path="user_first_name">
        <step action="SET_STATE">
            <path>data.reactive_log</path>
            <value>State Watcher [user_first_name]: Changed from '{prevValue}' to '{newValue}'</value>
        </step>
    </watch>

    <watch path="item_quantity">
        <step action="SET_STATE">
            <path>data.reactive_log</path>
            <value>State Watcher [item_quantity]: Quantity updated to {newValue}</value>
        </step>
    </watch>

    <collapse bind="data.reactive_open" title="⚡ Watch &amp; Computed State System (&lt;computed&gt;, &lt;watch&gt;)" class="border border-indigo-200/80 rounded-2xl overflow-hidden shadow-md bg-white" header_class="w-full flex items-center justify-between p-4 bg-gradient-to-r from-indigo-50 to-blue-50 border-b border-indigo-100 font-extrabold text-indigo-950 hover:bg-indigo-100/60 cursor-pointer text-sm" body_class="p-5 flex flex-col gap-5">
        <flex direction="column" gap="16" class="w-full">
            <flex direction="row" align="center" justify="between" class="p-3 bg-indigo-50/50 rounded-xl border border-indigo-100">
                <span class="text-xs font-bold text-indigo-900">Fine-grained reactive state dependencies with zero VDOM diffing overhead.</span>
                <span class="px-2.5 py-1 bg-indigo-600 text-white font-extrabold text-[10px] rounded-md uppercase tracking-wider">EUIXReactivePlugin</span>
            </flex>

            <!-- Inputs & Computed Grid -->
            <grid cols="2" gap="16" class="w-full grid-cols-1 md:grid-cols-2">
                <!-- User Profile Form Box -->
                <flex direction="column" gap="12" class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl">
                    <span class="text-xs font-black text-slate-700 uppercase tracking-wider">1. Live Inputs (Mutate State)</span>

                    <flex direction="column" gap="4">
                        <label class="text-[11px] font-bold text-slate-500">First Name</label>
                        <input bind="data.user_first_name" placeholder="First Name" class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 focus:outline-none focus:border-indigo-500" />
                    </flex>

                    <flex direction="column" gap="4">
                        <label class="text-[11px] font-bold text-slate-500">Last Name</label>
                        <input bind="data.user_last_name" placeholder="Last Name" class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 focus:outline-none focus:border-indigo-500" />
                    </flex>

                    <flex direction="row" gap="8">
                        <flex direction="column" gap="4" class="w-1/2">
                            <label class="text-[11px] font-bold text-slate-500">Quantity</label>
                            <input bind="data.item_quantity" type="number" min="1" class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 focus:outline-none focus:border-indigo-500" />
                        </flex>
                        <flex direction="column" gap="4" class="w-1/2">
                            <label class="text-[11px] font-bold text-slate-500">Unit Price ($)</label>
                            <input bind="data.unit_price" type="number" step="0.01" class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 focus:outline-none focus:border-indigo-500" />
                        </flex>
                    </flex>
                </flex>

                <!-- Memoized Computed Display Box -->
                <flex direction="column" gap="12" class="p-4 bg-slate-900 text-white border border-slate-800 rounded-xl justify-between">
                    <flex direction="column" gap="8">
                        <span class="text-xs font-black text-indigo-400 uppercase tracking-wider">2. Memoized Computed Properties (&lt;computed&gt;)</span>

                        <flex direction="column" class="p-3 bg-slate-950/80 rounded-lg border border-slate-800">
                            <span class="text-[10px] text-slate-400 font-bold uppercase">Computed Full Name</span>
                            <span class="text-sm font-black text-white">{data.display_full_name}</span>
                        </flex>

                        <flex direction="column" class="p-3 bg-slate-950/80 rounded-lg border border-slate-800">
                            <span class="text-[10px] text-slate-400 font-bold uppercase">Calculated Total Price</span>
                            <span class="text-lg font-black text-emerald-400">${data.calculated_total_price}</span>
                        </flex>
                    </flex>

                    <span class="text-[10px] text-slate-400 italic">Computed properties automatically memoize and recompute ONLY when specified dependencies mutate!</span>
                </flex>
            </grid>

            <!-- Reactive Watcher Log Stream -->
            <flex direction="row" align="center" gap="8" class="p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-900 text-xs font-bold">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                <span>{data.reactive_log}</span>
            </flex>
        </flex>
    </collapse>
</component_def>
