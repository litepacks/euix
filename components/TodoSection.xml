<component_def name="todo-section">
    <constants>
        <const id="quick_btn">px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg text-xs transition-colors cursor-pointer</const>
    </constants>
    <flex direction="column" gap="12" class="w-full bg-white p-3.5 sm:p-5 md:p-6 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 mb-6">
        <!-- Header Bar -->
        <flex class="border-b border-slate-100 pb-4 flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between w-full min-w-0">
            <flex direction="row" align="center" gap="12">
                <span class="text-3xl">📝</span>
                <flex direction="column">
                    <h2 class="font-extrabold text-slate-800 text-lg">Interactive Todo Manager</h2>
                    <span class="text-xs text-slate-500">Task additions, inline editing, array mutations &amp; quick actions</span>
                </flex>
            </flex>
            <flex direction="row" align="center" gap="8" class="flex-wrap">
                <span class="px-2.5 py-1 bg-blue-50 text-blue-700 font-extrabold text-xs rounded-lg border border-blue-200/60 hidden sm:inline-block">📄 140 Lines XML</span>
                <button type="button" class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-lg text-xs cursor-pointer transition-colors flex items-center gap-1">
                    <on_click action="SET_STATE">
                        <path>data.code_modal_title</path>
                        <value>Interactive Todo Manager (components/TodoSection.xml)</value>
                    </on_click>
                    <on_click action="SET_STATE">
                        <path>data.code_modal_lines</path>
                        <value>140</value>
                    </on_click>
                    <on_click action="XHR">
                        <method>GET</method>
                        <url>./components/TodoSection.xml</url>
                        <target>data.code_modal_content</target>
                    </on_click>
                    <on_click action="SET_STATE">
                        <path>data.code_modal_open</path>
                        <value>true</value>
                    </on_click>
                    🔍 View XML Code
                </button>
            </flex>
        </flex>

        <form class="flex flex-row gap-2">
            <on_submit action="MUTATE_STATE">
                <path>data.todos</path>
                <operation>PUSH</operation>
                <item text="{data.new_todo_input}" completed="false" />
            </on_submit>
            <input type="text" bind="data.new_todo_input" placeholder="Enter a new task..." class="flex-1 px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all" />
            <button type="submit" class="{const.btn_primary}">
                Add Task
            </button>
        </form>

        <flex direction="row" gap="8" align="center" justify="between" class="px-1">
            <flex direction="row" gap="6">
                <button class="{const.quick_btn}">
                    + Quick Task
                    <on_click action="MUTATE_STATE">
                        <path>data.todos</path>
                        <operation>PUSH</operation>
                        <item text="Quick Task {data.todos.length + 1}" completed="false" />
                    </on_click>
                </button>
                <button class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold rounded-lg text-xs transition-colors cursor-pointer">
                    Clear All Tasks
                    <on_click action="SET_STATE">
                        <path>data.confirm_modal_open</path>
                        <value>true</value>
                    </on_click>
                </button>
            </flex>
        </flex>

        <collapse bind="data.todos_open" title="Todo List" class="border border-slate-200/80 rounded-xl overflow-hidden shadow-sm" header_class="w-full flex items-center justify-between p-4 bg-slate-50/70 border-none font-bold text-slate-700 hover:bg-slate-50 cursor-pointer text-sm" body_class="p-4 flex flex-col gap-2">
            <flex direction="column" gap="8">
                <for_each items="{data.todos}" var="todo">
                    <flex direction="row" align="center" justify="between" gap="8" class="p-3 bg-white hover:bg-slate-50/50 border border-slate-100 rounded-lg transition-all shadow-sm">
                        <if condition="{data.editing_id} == {todo.id}">
                            <input type="text" bind="data.edit_todo_input" placeholder="Edit task..." autofocus="true" class="flex-1 px-3 py-1.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
                            <flex direction="row" gap="6">
                                <button class="px-3 py-1.5 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-lg text-xs cursor-pointer">
                                    Save
                                    <on_click action="MUTATE_STATE">
                                        <path>data.todos</path>
                                        <operation>UPDATE</operation>
                                        <where field="id" equals="{todo.id}" />
                                        <fields text="{data.edit_todo_input}" />
                                    </on_click>
                                </button>
                                <button class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold rounded-lg text-xs cursor-pointer">
                                    Cancel
                                    <on_click action="SET_STATE">
                                        <path>data.editing_id</path>
                                        <value></value>
                                    </on_click>
                                    <on_click action="SET_STATE">
                                        <path>data.edit_todo_input</path>
                                        <value></value>
                                    </on_click>
                                </button>
                            </flex>
                            <else>
                                <input type="checkbox" bind="todo.completed" class="w-5 h-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500/20 cursor-pointer" />
                                <if condition="{todo.completed} == true">
                                    <span class="flex-1 text-sm text-slate-400 line-through pl-1">{todo.text}</span>
                                    <else>
                                        <span class="flex-1 text-sm text-slate-700 font-medium pl-1">{todo.text}</span>
                                    </else>
                                </if>
                                <flex direction="row" gap="6">
                                    <button class="px-2.5 py-1.5 bg-slate-50 hover:bg-slate-100 text-slate-600 border border-slate-200 font-semibold rounded-lg text-xs transition-colors cursor-pointer">
                                        Edit
                                        <on_click action="SET_STATE">
                                            <path>data.editing_id</path>
                                            <value>{todo.id}</value>
                                        </on_click>
                                        <on_click action="SET_STATE">
                                            <path>data.edit_todo_input</path>
                                            <value>{todo.text}</value>
                                            <focus>data.edit_todo_input</focus>
                                        </on_click>
                                    </button>
                                    <button class="px-2.5 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold rounded-lg text-xs transition-colors cursor-pointer">
                                        Delete
                                        <on_click action="SET_STATE">
                                            <path>data.selected_todo_id</path>
                                            <value>{todo.id}</value>
                                        </on_click>
                                        <on_click action="SET_STATE">
                                            <path>data.delete_modal_open</path>
                                            <value>true</value>
                                        </on_click>
                                    </button>
                                </flex>
                            </else>
                        </if>
                    </flex>
                </for_each>
            </flex>
        </collapse>
    </flex>
</component_def>