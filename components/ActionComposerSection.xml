<component_def name="action-composer-section">
    <data_model>
        <state id="composer_open">true</state>
        <state id="composer_status">Ready</state>
        <state id="composer_tasks" type="array"></state>
        <state id="action_logs" type="array"></state>
        <state id="last_notification">None</state>
    </data_model>

    <flex direction="column" class="w-full">
        <collapse bind="data.composer_open" title="⚡ Action Composer (Reusable Workflows & Subroutines)" class="border border-slate-200/80 rounded-xl overflow-hidden shadow-sm" header_class="w-full flex items-center justify-between p-4 bg-slate-50/70 border-none font-bold text-slate-700 hover:bg-slate-50 cursor-pointer text-sm" body_class="p-4 flex flex-col gap-4">

        <!-- Composed Action Definitions -->
        <actions>
            <!-- Workflow 1: Reusable Notification & Log Action -->
            <action_def name="LogAndNotify">
                <param name="message" required="true" />
                <param name="type" default="info" />

                <step action="SET_STATE">
                    <path>data.last_notification</path>
                    <value>{args.message}</value>
                </step>

                <step action="MUTATE_STATE">
                    <path>data.action_logs</path>
                    <operation>UNSHIFT</operation>
                    <value>{"text": "[{args.type}] {args.message}"}</value>
                </step>
            </action_def>

            <!-- Workflow 2: Complex Task Saving Subroutine -->
            <action_def name="SaveTaskWorkflow">
                <param name="taskTitle" required="true" />
                <param name="category" default="General" />

                <!-- Step 1: Update status state -->
                <step action="SET_STATE">
                    <path>data.composer_status</path>
                    <value>Saving task '{args.taskTitle}'...</value>
                </step>

                <!-- Step 2: Push task to tasks array state -->
                <step action="MUTATE_STATE">
                    <path>data.composer_tasks</path>
                    <operation>UNSHIFT</operation>
                    <value>{"id": "{data.composer_tasks.length + 1}", "title": "{args.taskTitle}", "category": "{args.category}"}</value>
                </step>

                <!-- Step 3: Invoke nested action workflow (LogAndNotify) -->
                <step action="EXECUTE_ACTION" name="LogAndNotify">
                    <arg name="message">Task '{args.taskTitle}' created under {args.category}</arg>
                    <arg name="type">success</arg>
                </step>

                <!-- Step 4: Final status update -->
                <step action="SET_STATE">
                    <path>data.composer_status</path>
                    <value>Task '{args.taskTitle}' saved successfully!</value>
                </step>

                <return>{args.taskTitle}</return>
            </action_def>
        </actions>

        <!-- Section Header Explanation -->
        <flex direction="column" gap="4">
            <span class="text-sm font-bold text-slate-800">⚡ Action Composer Workflow System</span>
            <span class="text-[11px] text-slate-500">Demonstrating reusable workflows (&lt;action_def&gt;), parameter passing, nested action calls, and state mutation.</span>
        </flex>

        <!-- Triggers Section: Demonstrating reuse from multiple UI elements -->
        <flex direction="column" gap="10" class="p-3.5 bg-slate-50/80 border border-slate-200/70 rounded-xl">
            <span class="text-xs font-bold text-slate-700">Quick Workflow Triggers (Reusing <code class="text-indigo-600 font-mono">SaveTaskWorkflow</code>)</span>

            <flex direction="row" gap="8" wrap="wrap">
                <!-- Trigger 1: Save Bug Fix Task -->
                <button class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer shadow-sm">
                    <span>➕ Add Bugfix Task</span>
                    <on_click action="EXECUTE_ACTION" name="SaveTaskWorkflow">
                        <arg name="taskTitle">Fix API Cache Invalidation</arg>
                        <arg name="category">Engineering</arg>
                    </on_click>
                </button>

                <!-- Trigger 2: Save Design Task (Short-hand direct invocation) -->
                <button class="px-3 py-1.5 bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer shadow-sm">
                    <span>🎨 Add Design Task</span>
                    <on_click action="SaveTaskWorkflow">
                        <arg name="taskTitle">Redesign Dashboard Layout</arg>
                        <arg name="category">Design</arg>
                    </on_click>
                </button>

                <!-- Trigger 3: Invoke LogAndNotify Directly -->
                <button class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs rounded-lg transition-colors cursor-pointer shadow-sm">
                    <span>🔔 Send Custom Alert</span>
                    <on_click action="LogAndNotify">
                        <arg name="message">System backup initiated</arg>
                        <arg name="type">system</arg>
                    </on_click>
                </button>
            </flex>
        </flex>

        <!-- Dynamic Output Section: Task List & Activity Audit Trail -->
        <grid cols="2" gap="12" class="mt-2">
            <!-- Left: Created Tasks List -->
            <flex direction="column" gap="6" class="p-3 bg-white border border-slate-200/80 rounded-xl">
                <flex direction="row" align="center" justify="between">
                    <span class="text-xs font-bold text-slate-700">Created Tasks ({data.composer_tasks.length})</span>
                    <span class="text-[11px] text-slate-500 font-medium">{data.composer_status}</span>
                </flex>

                <flex direction="column" gap="4" class="max-h-40 overflow-y-auto">
                    <for_each items="{data.composer_tasks}" var="task">
                        <flex direction="row" align="center" justify="between" class="p-2 bg-slate-50 border border-slate-200/60 rounded-lg">
                            <span class="text-xs font-semibold text-slate-800">{task.title}</span>
                            <span class="text-[10px] px-2 py-0.5 bg-indigo-100 text-indigo-700 font-bold rounded-full">{task.category}</span>
                        </flex>
                    </for_each>
                </flex>
            </flex>

            <!-- Right: Action Workflow Execution Logs -->
            <flex direction="column" gap="6" class="p-3 bg-white border border-slate-200/80 rounded-xl">
                <span class="text-xs font-bold text-slate-700">Action Trace &amp; Audit Log</span>
                <span class="text-[11px] text-slate-500 font-medium">Last Notification: <strong class="text-indigo-600">{data.last_notification}</strong></span>

                <flex direction="column" gap="4" class="max-h-40 overflow-y-auto">
                    <for_each items="{data.action_logs}" var="log">
                        <span class="text-[11px] text-slate-600 border-b border-slate-100 pb-1">⚡ {log.text}</span>
                    </for_each>
                </flex>
            </flex>
        </grid>
        </collapse>
    </flex>
</component_def>
