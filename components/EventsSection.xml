<component_def name="events-section">
    <collapse bind="data.events_open" title="⚡ Universal Event Listeners &amp; Actions" class="border border-slate-800 rounded-2xl overflow-hidden shadow-sm bg-slate-950/80 mb-6" header_class="w-full flex items-center justify-between p-4 bg-slate-900 border-none font-bold text-white hover:bg-slate-800/80 cursor-pointer text-sm" body_class="p-4 sm:p-5 flex flex-col gap-4">
        <grid cols="2" gap="12" class="w-full grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Example 1: Hover Events -->
            <flex direction="column" gap="6" class="p-4 bg-slate-900/90 border border-slate-800 rounded-2xl">
                <span class="text-xs font-bold text-slate-300">Example 1: Mouse Enter / Leave</span>
                <div class="p-4 bg-slate-950 border border-dashed border-slate-700 rounded-xl text-center cursor-pointer transition-colors hover:border-indigo-500">
                    <span class="text-xs font-medium text-slate-300">{data.hover_status}</span>
                    <on_mouseenter action="SET_STATE">
                        <path>data.hover_status</path>
                        <value>Mouse hovered over the box! ✨</value>
                    </on_mouseenter>
                    <on_mouseleave action="SET_STATE">
                        <path>data.hover_status</path>
                        <value>Mouse left the box...</value>
                    </on_mouseleave>
                </div>
            </flex>

            <!-- Example 2: Focus & Keyboard -->
            <flex direction="column" gap="6" class="p-4 bg-slate-900/90 border border-slate-800 rounded-2xl">
                <span class="text-xs font-bold text-slate-300">Example 2: Keyboard &amp; Focus</span>
                <flex direction="row" gap="6">
                    <input type="text" bind="data.quick_todo_input" placeholder="Type and press Enter..." class="flex-1 px-3.5 py-2 bg-slate-950 border border-slate-800 text-white rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                        <on_keyup key="Enter" action="MUTATE_STATE">
                            <path>data.todos</path>
                            <operation>PUSH</operation>
                            <item text="{data.quick_todo_input}" completed="false" />
                            <reset path="data.quick_todo_input" />
                        </on_keyup>
                    </input>
                </flex>
            </flex>
        </grid>

        <flex direction="row" justify="between" align="center" class="pt-2 border-t border-slate-800 flex-wrap gap-2">
            <button class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition-colors shadow-lg shadow-indigo-600/20 cursor-pointer">
                Open Custom Confirm Dialog
                <on_click action="SET_STATE">
                    <path>data.confirm_modal_open</path>
                    <value>true</value>
                </on_click>
            </button>

            <button class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs rounded-xl transition-colors cursor-pointer border border-slate-700">
                Open Help Modal
                <on_click action="SET_STATE">
                    <path>data.help_open</path>
                    <value>true</value>
                </on_click>
            </button>
        </flex>
    </collapse>
</component_def>