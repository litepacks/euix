<component_def name="events-section">
    <collapse bind="data.events_open" title="⚡ Universal Event Listeners &amp; Actions" class="border border-slate-200/80 rounded-xl overflow-hidden shadow-sm" header_class="w-full flex items-center justify-between p-4 bg-slate-50/70 border-none font-bold text-slate-700 hover:bg-slate-50 cursor-pointer text-sm" body_class="p-4 flex flex-col gap-4">
        <grid cols="2" gap="12">
            <!-- Example 1: Hover Events -->
            <flex direction="column" gap="6" class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="text-xs font-bold text-slate-700">Example 1: Mouse Enter / Leave</span>
                <div class="p-4 bg-white border border-dashed border-slate-300 rounded-lg text-center cursor-pointer transition-colors hover:border-blue-400">
                    <span class="text-xs font-medium text-slate-600">{data.hover_status}</span>
                    <on_mouseenter action="SET_STATE">
                        <path>data.hover_status</path>
                        <value>Mouse hovered over the box! ✨</value>
                    </on_mouseenter>
                    <on_mouseleave action="SET_STATE">
                        <path>data.hover_status</path>
                        <value>Mouse left the box...</value>
                    </on_mouseleave>
                </div>
            </flex>

            <!-- Example 2: Focus & Keyboard -->
            <flex direction="column" gap="6" class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="text-xs font-bold text-slate-700">Example 2: Keyboard &amp; Focus</span>
                <flex direction="row" gap="6">
                    <input type="text" bind="data.quick_todo_input" placeholder="Type and press Enter..." class="flex-1 px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                        <on_keyup key="Enter" action="MUTATE_STATE">
                            <path>data.todos</path>
                            <operation>PUSH</operation>
                            <item text="{data.quick_todo_input}" completed="false" />
                            <reset path="data.quick_todo_input" />
                        </on_keyup>
                    </input>
                </flex>
            </flex>
        </grid>

        <flex direction="row" justify="between" align="center" class="pt-2 border-t border-slate-100">
            <button class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition-colors shadow-md shadow-indigo-500/20 cursor-pointer">
                Open Custom Confirm Dialog
                <on_click action="SET_STATE">
                    <path>data.confirm_modal_open</path>
                    <value>true</value>
                </on_click>
            </button>

            <button class="px-3.5 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs rounded-xl transition-colors cursor-pointer">
                Open Help Modal
                <on_click action="SET_STATE">
                    <path>data.help_open</path>
                    <value>true</value>
                </on_click>
            </button>
        </flex>
    </collapse>
</component_def>