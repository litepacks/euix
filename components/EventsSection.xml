<component_def name="events-section">
    <collapse bind="data.events_open" class="border border-slate-200/80 rounded-xl overflow-hidden shadow-sm" header_class="w-full flex items-center justify-between p-4 bg-slate-50/70 border-none font-bold text-slate-700 hover:bg-slate-50 cursor-pointer text-sm" body_class="p-4 flex flex-col gap-4">
        <summary>⚡ Evrensel Olay Örnekleri (Enter &amp; Mouse Events)</summary>
        
        <!-- Örnek 1: Enter Tuşu İle Ekleme -->
        <flex direction="column" gap="6" class="p-3.5 bg-slate-50 border border-slate-100 rounded-xl">
            <component type="text" class="text-xs font-bold text-slate-700">1. Enter Tuşuna Basarak Hızlı Ekle (event type="keyup" key="Enter"):</component>
            <component type="text_input" bind="data.quick_todo_input" placeholder="Görevi yazıp ENTER'a basın..." class="w-full px-3.5 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                <event type="keyup" key="Enter" action="MUTATE_STATE">
                    <path>data.todos</path>
                    <operation>PUSH</operation>
                    <value>
                        <item text="{data.quick_todo_input}" />
                    </value>
                    <reset path="data.quick_todo_input" />
                </event>
            </component>
            <component type="text" class="text-[11px] text-slate-400">Yazdıktan sonra Enter'a bastığınızda yukarıdaki Todo Listesine otomatik eklenir.</component>
        </flex>

        <!-- Örnek 2: MouseEnter / MouseLeave Olayları -->
        <flex direction="column" gap="6" class="p-3.5 bg-indigo-50/50 border border-indigo-100 rounded-xl transition-all">
            <component type="text" class="text-xs font-bold text-indigo-900">2. Fare Hareket Olayları (event type="mouseenter" / "mouseleave"):</component>
            <flex direction="row" align="center" justify="between" class="p-3 bg-white border border-indigo-100 rounded-lg shadow-sm">
                <component type="text" class="text-xs font-semibold text-slate-700" bind="data.hover_status" />
                <event type="mouseenter" action="SET_STATE">
                    <path>data.hover_status</path>
                    <value>🎉 Fare kutunun üzerinde! (mouseenter algılandı)</value>
                </event>
                <event type="mouseleave" action="SET_STATE">
                    <path>data.hover_status</path>
                    <value>Fare ayrıldı. (mouseleave algılandı)</value>
                </event>
            </flex>
        </flex>
    </collapse>
</component_def>
