<component_def id="code-viewer-modal">
    <flex direction="column">
        <if condition="{data.code_modal_open} == 'true'">
            <!-- Backdrop -->
            <div class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-[99990] flex items-center justify-center p-4 sm:p-6 animate-fadeIn">
                <!-- Modal Box -->
                <flex direction="column" class="bg-slate-900 border border-slate-800 text-white rounded-2xl w-full max-w-4xl max-h-[85vh] shadow-2xl overflow-hidden">
                    
                    <!-- Header -->
                    <flex direction="row" align="center" justify="between" class="p-4 border-b border-slate-800 bg-slate-950/80">
                        <flex direction="row" align="center" gap="10">
                            <span class="text-xl">📄</span>
                            <flex direction="column">
                                <span class="text-sm font-extrabold text-white">{data.code_modal_title}</span>
                                <span class="text-xs text-indigo-400 font-mono font-semibold">{data.code_modal_lines} Lines of Declarative XML</span>
                            </flex>
                        </flex>

                        <flex direction="row" align="center" gap="8">
                            <button type="button" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 shadow-md">
                                <on_click action="SET_STATE">
                                    <path>data.code_modal_open</path>
                                    <value>false</value>
                                </on_click>
                                ✕ Close
                            </button>
                        </flex>
                    </flex>

                    <!-- Code Content Area -->
                    <div class="p-4 overflow-y-auto max-h-[calc(85vh-80px)] bg-slate-950 font-mono text-xs text-indigo-200">
                        <pre class="whitespace-pre-wrap break-words leading-relaxed select-all"><code>{data.code_modal_content}</code></pre>
                    </div>

                    <!-- Footer -->
                    <flex direction="row" align="center" justify="between" class="p-3 px-4 border-t border-slate-800 bg-slate-950/90 text-xs text-slate-400">
                        <span>⚡ Vanilla .EUIX Engine — Zero JS Boilerplate</span>
                        <button type="button" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs rounded-lg cursor-pointer transition-colors">
                            <on_click action="SET_STATE">
                                <path>data.code_modal_open</path>
                                <value>false</value>
                            </on_click>
                            Done Inspecting
                        </button>
                    </flex>
                </flex>
            </div>
        </if>
    </flex>
</component_def>
