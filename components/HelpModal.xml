<component_def name="help-modal">
    <dialog bind="data.help_open" title="❓ EUIX Engine Quick Help">
        <flex direction="column" gap="12" class="p-1 text-xs text-slate-600">
            <span class="font-bold text-slate-800 text-sm">Key Features &amp; Syntax:</span>
            <span>• <strong>Declarative Layouts:</strong> Use &lt;flex&gt;, &lt;grid&gt;, &lt;collapse&gt;, &lt;dialog&gt; natively.</span>
            <span>• <strong>Fine-Grained Reactivity:</strong> Proxy-based state updates without Virtual DOM re-renders.</span>
            <span>• <strong>Declarative Actions:</strong> SET_STATE, MUTATE_STATE, XHR, FOCUS.</span>
            <span>• <strong>Zero Build Required:</strong> Runs directly in the browser via standard DOM APIs.</span>

            <flex direction="row" justify="end" class="mt-3">
                <button class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer">
                    Close
                    <on_click action="SET_STATE">
                        <path>data.help_open</path>
                        <value>false</value>
                    </on_click>
                </button>
            </flex>
        </flex>
    </dialog>
</component_def>