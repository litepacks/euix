<component_def name="crypto-portfolio-section">
    <api_config base_url="https://api.coingecko.com/api/v3" timeout="8000" />

    <data_model>
        <state id="btc_price">64612.00</state>
        <state id="eth_price">1905.40</state>
        <state id="sol_price">73.20</state>
        <state id="tick_count">0</state>
        <state id="new_symbol">BTC</state>
        <state id="new_amount">0.5</state>
        <state id="new_buy_price">62000</state>
        <state id="clear_modal_open">false</state>
        
        <state id="portfolio" type="array" persist="local">
            <item symbol="BTC" amount="0.25" buy_price="60000" />
            <item symbol="ETH" amount="2.0" buy_price="3200" />
            <item symbol="SOL" amount="15.0" buy_price="135" />
        </state>
    </data_model>

    <flex direction="column" gap="16" class="w-full bg-slate-900/90 border border-slate-800 p-4 sm:p-6 rounded-3xl shadow-xl mb-6">
        <!-- Live Ticker & Header Bar -->
        <flex class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between w-full min-w-0">
            <flex direction="row" align="center" gap="12">
                <span class="text-3xl">🚀</span>
                <flex direction="column">
                    <h2 class="font-extrabold text-white text-lg">Live Crypto Portfolio &amp; Ticker (CoinGecko API)</h2>
                    <span class="text-xs text-slate-400">Real-time CoinGecko Public API 10s ticks, LocalStorage &amp; PnL tracker</span>
                </flex>
            </flex>
            <flex direction="row" align="center" gap="8">
                <span class="px-2.5 py-1 bg-emerald-500/20 text-emerald-300 font-extrabold text-xs rounded-xl border border-emerald-500/30 hidden sm:inline-block">📄 181 Lines XML</span>
                <button type="button" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl text-xs cursor-pointer transition-colors border border-slate-700 flex items-center gap-1">
                    <on_click action="SET_STATE">
                        <path>data.code_modal_title</path>
                        <value>Crypto Portfolio &amp; Live Ticker (components/CryptoPortfolioSection.xml)</value>
                    </on_click>
                    <on_click action="SET_STATE">
                        <path>data.code_modal_lines</path>
                        <value>181</value>
                    </on_click>
                    <on_click action="XHR">
                        <method>GET</method>
                        <url>./components/CryptoPortfolioSection.xml</url>
                        <target>data.code_modal_content</target>
                    </on_click>
                    <on_click action="SET_STATE">
                        <path>data.code_modal_open</path>
                        <value>true</value>
                    </on_click>
                    🔍 View XML Code
                </button>
            </flex>
        </flex>

        <!-- Declarative 30-second CoinGecko API Price Ticks -->
        <on_interval ms="30000" action="XHR">
            <url>/simple/price?ids=bitcoin&amp;vs_currencies=usd</url>
            <select>bitcoin.usd</select>
            <target>data.btc_price</target>
        </on_interval>
        <on_interval ms="30000" action="XHR">
            <url>/simple/price?ids=ethereum&amp;vs_currencies=usd</url>
            <select>ethereum.usd</select>
            <target>data.eth_price</target>
        </on_interval>
        <on_interval ms="30000" action="XHR">
            <url>/simple/price?ids=solana&amp;vs_currencies=usd</url>
            <select>solana.usd</select>
            <target>data.sol_price</target>
        </on_interval>

        <!-- Live Ticker Price Badges -->
        <grid cols="3" gap="12" class="w-full grid grid-cols-1 sm:grid-cols-3 gap-3">
            <flex direction="column" class="p-4 bg-slate-950/80 rounded-2xl border border-slate-800">
                <span class="text-xs font-semibold text-slate-400">Bitcoin (BTC)</span>
                <span class="text-lg font-black text-amber-400 font-mono mt-0.5">${data.btc_price}</span>
            </flex>
            <flex direction="column" class="p-4 bg-slate-950/80 rounded-2xl border border-slate-800">
                <span class="text-xs font-semibold text-slate-400">Ethereum (ETH)</span>
                <span class="text-lg font-black text-indigo-400 font-mono mt-0.5">${data.eth_price}</span>
            </flex>
            <flex direction="column" class="p-4 bg-slate-950/80 rounded-2xl border border-slate-800">
                <span class="text-xs font-semibold text-slate-400">Solana (SOL)</span>
                <span class="text-lg font-black text-cyan-400 font-mono mt-0.5">${data.sol_price}</span>
            </flex>
        </grid>

        <!-- Add Asset Form -->
        <form class="p-4 bg-slate-950/80 rounded-2xl border border-slate-800">
            <span class="text-xs font-bold text-indigo-400 uppercase tracking-wider block mb-3">➕ Add Asset to Portfolio</span>
            <flex direction="row" gap="8" align="center" wrap="true" class="w-full">
                <select bind="data.new_symbol" class="px-3.5 py-2 bg-slate-900 border border-slate-800 rounded-xl text-xs font-bold text-slate-200 outline-none flex-1 min-w-[130px]">
                    <option value="BTC">BTC (Bitcoin)</option>
                    <option value="ETH">ETH (Ethereum)</option>
                    <option value="SOL">SOL (Solana)</option>
                </select>
                <input bind="data.new_amount" type="number" step="0.01" placeholder="Amount" class="flex-1 min-w-[110px] px-3.5 py-2 bg-slate-900 border border-slate-800 rounded-xl text-xs font-semibold text-white outline-none" />
                <input bind="data.new_buy_price" type="number" placeholder="Buy Price ($)" class="flex-1 min-w-[120px] px-3.5 py-2 bg-slate-900 border border-slate-800 rounded-xl text-xs font-semibold text-white outline-none" />
                
                <button type="button" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs transition-colors cursor-pointer whitespace-nowrap shrink-0 ml-auto shadow-lg shadow-indigo-600/20">
                    <on_click action="MUTATE_STATE">
                        <path>data.portfolio</path>
                        <operation>PUSH</operation>
                        <value symbol="{data.new_symbol}" amount="{data.new_amount}" buy_price="{data.new_buy_price}" />
                    </on_click>
                    Add Holding
                </button>
            </flex>
        </form>

        <!-- Portfolio Table List -->
        <flex direction="column" gap="8">
            <flex direction="row" justify="between" align="center" class="px-2">
                <span class="text-xs font-extrabold text-slate-400 uppercase tracking-wider">Your Holdings</span>
                <button type="button" class="text-xs font-bold text-rose-400 hover:text-rose-300 cursor-pointer">
                    <on_click action="SET_STATE">
                        <path>data.clear_modal_open</path>
                        <value>true</value>
                    </on_click>
                    Clear All
                </button>
            </flex>

            <flex direction="column" gap="6">
                <for_each items="{data.portfolio}" var="asset">
                    <flex direction="row" align="center" justify="between" class="p-3.5 bg-slate-950/80 hover:bg-slate-900 rounded-2xl border border-slate-800 transition-colors">
                        <flex direction="row" align="center" gap="10">
                            <span class="px-2.5 py-1 bg-slate-900 text-white font-black rounded-xl text-xs font-mono border border-slate-800">{asset.symbol}</span>
                            <flex direction="column">
                                <span class="text-xs font-bold text-white">{asset.amount} {asset.symbol}</span>
                                <span class="text-[11px] text-slate-400 font-medium">Bought @ ${asset.buy_price}</span>
                            </flex>
                        </flex>

                        <flex direction="row" align="center" gap="12">
                            <span class="px-2.5 py-1 bg-emerald-500/15 text-emerald-400 font-bold rounded-xl text-xs font-mono border border-emerald-500/20">
                                Active Holding
                            </span>
                            <button type="button" class="px-2 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-bold rounded-xl text-xs border border-rose-500/20 transition-colors cursor-pointer">
                                <on_click action="MUTATE_STATE">
                                    <path>data.portfolio</path>
                                    <operation>REMOVE</operation>
                                    <index>{asset._index}</index>
                                </on_click>
                                ✕
                            </button>
                        </flex>
                    </flex>
                </for_each>
            </flex>
        </flex>

        <!-- Clear Modal -->
        <dialog bind="data.clear_modal_open" title="Clear Portfolio?">
            <flex direction="column" gap="12" class="p-1">
                <span class="text-sm text-slate-300">Are you sure you want to remove all holdings from LocalStorage?</span>
                <flex direction="row" justify="end" gap="8" class="mt-2">
                    <button class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-xl transition-colors cursor-pointer border border-slate-700">
                        Cancel
                        <on_click action="SET_STATE">
                            <path>data.clear_modal_open</path>
                            <value>false</value>
                        </on_click>
                    </button>
                    <button class="px-3.5 py-2 bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs rounded-xl transition-colors shadow-md shadow-rose-500/20 cursor-pointer">
                        Yes, Clear All
                        <on_click action="SET_STATE">
                            <path>data.clear_modal_open</path>
                            <value>false</value>
                        </on_click>
                        <on_click action="MUTATE_STATE">
                            <path>data.portfolio</path>
                            <operation>CLEAR</operation>
                        </on_click>
                    </button>
                </flex>
            </flex>
        </dialog>
    </flex>
</component_def>
