<component_def name="api-client-section">
    <api_config base_url="https://jsonplaceholder.typicode.com" credentials="omit" timeout="10000">
        <headers>
            <header name="X-Engine-Client">EUIX-Engine-v1.0</header>
            <header name="Authorization">Bearer demo_jwt_token_999</header>
        </headers>
    </api_config>

    <data_model>
        <state id="api_users" type="array"></state>
        <state id="api_loading">false</state>
        <state id="api_error"></state>
    </data_model>

    <flex direction="column" gap="16" class="w-full bg-white p-3.5 sm:p-5 md:p-6 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 mb-6">
        <flex direction="row" align="center" justify="between" class="border-b border-slate-100 pb-3">
            <flex direction="row" align="center" gap="8">
                <span class="text-xl">🌐</span>
                <flex direction="column">
                    <h2 class="font-extrabold text-slate-800 text-base">API Client Demo (&lt;api_config&gt;)</h2>
                    <span class="text-xs text-slate-500">Centralized BaseURL, Default Headers, Credentials options &amp; Timeout</span>
                </flex>
            </flex>
            <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 font-bold rounded-lg text-xs border border-indigo-200/60">
                🚀 Configured BaseURL: jsonplaceholder.typicode.com
            </span>
        </flex>

        <flex direction="column" gap="12" class="bg-slate-50 p-4 rounded-xl border border-slate-100">
            <flex direction="row" align="center" justify="between">
                <span class="text-xs font-bold text-slate-700">Relative Endpoint Test: <code class="bg-slate-200 px-1 py-0.5 rounded text-blue-600">GET /users?_limit=3</code></span>
                <button class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg text-xs transition-colors cursor-pointer flex items-center gap-1.5">
                    <on_click action="XHR">
                        <method>GET</method>
                        <url>/users?_limit=3</url>
                        <target>data.api_users</target>
                        <loading>data.api_loading</loading>
                        <error>data.api_error</error>
                    </on_click>
                    📡 Fetch Users via BaseURL
                </button>
            </flex>

            <!-- Loading & Error -->
            <if condition="{data.api_loading} == true">
                <span class="text-xs text-indigo-600 font-bold p-2 text-center">Fetching from API via configured BaseURL...</span>
            </if>
            <if condition="{data.api_error} != ''">
                <span class="text-xs text-rose-600 font-bold p-2 text-center">Error: {data.api_error}</span>
            </if>

            <flex direction="column" gap="8">
                <for_each items="{data.api_users}" var="user">
                    <flex direction="row" align="center" justify="between" class="p-3 bg-white border border-slate-200 rounded-lg text-xs">
                        <flex direction="column">
                            <span class="font-bold text-slate-800">{user.name}</span>
                            <span class="text-slate-500 font-mono">{user.email}</span>
                        </flex>
                        <span class="px-2 py-0.5 bg-slate-100 text-slate-600 font-mono text-[10px] rounded font-bold">
                            ID: #{user.id}
                        </span>
                    </flex>
                </for_each>
            </flex>
        </flex>
    </flex>
</component_def>
