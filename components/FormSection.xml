<component_def name="form-section">
    <collapse bind="data.form_open" title="📋 Form Controls &amp; Live Binding" class="border border-slate-200/80 rounded-xl overflow-hidden shadow-sm" header_class="w-full flex items-center justify-between p-4 bg-slate-50/70 border-none font-bold text-slate-700 hover:bg-slate-50 cursor-pointer text-sm" body_class="p-4 flex flex-col gap-4">
        <flex direction="column" gap="12" class="p-4 bg-slate-50/50 border border-slate-100 rounded-xl">
            <flex direction="column" gap="4">
                <label class="text-xs font-bold text-slate-700">Biography (Textarea Live Bind)</label>
                <textarea bind="data.form_bio" rows="2" placeholder="Write your biography..." class="w-full p-2.5 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
            </flex>

            <grid cols="2" gap="12" class="w-full grid grid-cols-1 sm:grid-cols-2 gap-3">
                <flex direction="column" gap="4">
                    <label class="text-xs font-bold text-slate-700">Category (Select)</label>
                    <select bind="data.form_category" class="w-full p-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none">
                        <option value="frontend">Frontend Engineering</option>
                        <option value="backend">Backend Engineering</option>
                        <option value="fullstack">Fullstack Development</option>
                        <option value="devops">DevOps &amp; Infrastructure</option>
                    </select>
                </flex>

                <flex direction="column" gap="4">
                    <label class="text-xs font-bold text-slate-700">Seniority Level (Radio)</label>
                    <flex direction="row" gap="12" class="pt-1">
                        <label class="flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer">
                            <input type="radio" name="seniority" value="junior" bind="data.form_level" /> Junior
                        </label>
                        <label class="flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer">
                            <input type="radio" name="seniority" value="mid" bind="data.form_level" /> Mid
                        </label>
                        <label class="flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer">
                            <input type="radio" name="seniority" value="senior" bind="data.form_level" /> Senior
                        </label>
                    </flex>
                </flex>
            </grid>

            <grid cols="2" gap="12" class="w-full grid grid-cols-1 sm:grid-cols-2 gap-3">
                <flex direction="column" gap="4">
                    <label class="text-xs font-bold text-slate-700">Expected Salary (Range: {data.form_salary}k $)</label>
                    <input type="range" min="30" max="150" step="5" bind="data.form_salary" class="w-full accent-blue-600 cursor-pointer" />
                </flex>

                <flex direction="column" gap="4">
                    <label class="text-xs font-bold text-slate-700">Weekly Hours (Number)</label>
                    <input type="number" min="10" max="60" bind="data.form_hours" class="w-full p-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none" />
                </flex>
            </grid>
        </flex>

        <!-- Native HTML5 Validated Form Demo -->
        <form class="p-4 bg-emerald-50/50 border border-emerald-100 rounded-xl flex flex-col gap-3">
            <span class="text-xs font-bold text-emerald-950 uppercase tracking-wider">🛡️ Native HTML5 Validated Form</span>
            <grid cols="2" gap="12" class="w-full grid grid-cols-1 sm:grid-cols-2 gap-3">
                <flex direction="column" gap="4">
                    <label class="text-xs font-bold text-slate-700">Email Address (Required, Type: Email)</label>
                    <input type="email" required="true" bind="data.form_email" placeholder="john@example.com" class="w-full p-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none invalid:border-rose-500 invalid:text-rose-600" />
                </flex>
                <flex direction="column" gap="4">
                    <label class="text-xs font-bold text-slate-700">Username (Required, Min 4 Chars)</label>
                    <input type="text" required="true" minlength="4" bind="data.form_username" placeholder="john_doe" class="w-full p-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none invalid:border-rose-500 invalid:text-rose-600" />
                </flex>
            </grid>
            <flex direction="row" align="center" justify="between" class="pt-1">
                <span class="text-xs font-semibold text-emerald-800">{data.form_status}</span>
                <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition-all shadow-sm active:scale-95 cursor-pointer">
                    Submit Validated Form
                    <on_click action="SET_STATE">
                        <path>data.form_status</path>
                        <value>✅ Form Successfully Validated &amp; Submitted ({data.form_username})!</value>
                    </on_click>
                </button>
            </flex>
        </form>

        <!-- Dynamic Reactive Attributes Demo -->
        <flex direction="column" gap="10" class="p-4 bg-sky-50/50 border border-sky-100 rounded-xl">
            <span class="text-xs font-bold text-sky-950 uppercase tracking-wider">⚡ Dynamic Reactive Attributes &amp; Class Binding Demo</span>
            <grid cols="2" gap="12">
                <flex direction="column" gap="4">
                    <label class="text-xs font-bold text-slate-700">Dynamic Placeholder &amp; Title</label>
                    <input type="text" placeholder="{data.dyn_placeholder}" title="Dynamic Title: {data.dyn_placeholder}" class="w-full p-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none" />
                </flex>
                <flex direction="column" gap="4">
                    <label class="text-xs font-bold text-slate-700">Dynamic Class &amp; Disabled State</label>
                    <flex direction="row" gap="8">
                        <button disabled="{data.is_btn_disabled}" class="px-3 py-2 text-white rounded-lg text-xs font-bold transition-all cursor-pointer {data.is_btn_disabled == 'true' ? 'bg-slate-400 opacity-60 cursor-not-allowed' : 'bg-sky-600 hover:bg-sky-700 shadow-sm'}">
                            {data.is_btn_disabled == 'true' ? '🔒 Button Disabled' : '⚡ Action Button Active'}
                        </button>
                        <button class="px-3 py-2 bg-slate-700 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold cursor-pointer">
                            Toggle State ({data.is_btn_disabled})
                            <on_click action="SET_STATE">
                                <path>data.is_btn_disabled</path>
                                <value>{data.is_btn_disabled == 'true' ? 'false' : 'true'}</value>
                            </on_click>
                        </button>
                    </flex>
                </flex>
            </grid>
        </flex>

        <flex direction="column" gap="6" class="p-4 bg-indigo-50/50 border border-indigo-100 rounded-xl">
            <span class="text-xs font-black text-indigo-900 uppercase tracking-wider">Live Form Summary</span>
            <flex direction="column" gap="4" class="text-xs text-indigo-800">
                <span>• <strong>Bio:</strong> <em>{data.form_bio}</em></span>
                <span>• <strong>Category:</strong> <em>{data.form_category}</em> | <strong>Seniority:</strong> <em>{data.form_level}</em></span>
                <span>• <strong>Salary:</strong> <em>{data.form_salary}k $</em> | <strong>Hours:</strong> <em>{data.form_hours} hrs/week</em></span>
            </flex>
        </flex>
    </collapse>
</component_def>