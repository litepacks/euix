<component_def name="doc-portal-section">
    <data_model>
        <state id="active_tab" type="string">overview</state>
        <state id="active_doc_topic" type="string">getting_started</state>
        <state id="copied_status" type="string">Copy Spec</state>
        <state id="playground_code" type="string"><![CDATA[<uid_spec>
  <data_model>
    <state id="count">0</state>
  </data_model>
  <flex direction="column" gap="12" class="p-6 bg-white rounded-2xl shadow-xl">
    <h2 class="text-lg font-bold">Counter: {data.count}</h2>
    <button class="px-4 py-2 bg-blue-600 text-white font-bold rounded-lg">
      <on_click action="SET_STATE">
        <path>data.count</path>
        <value>{data.count + 1}</value>
      </on_click>
      Increment
    </button>
  </flex>
</uid_spec>]]></state>
    </data_model>

    <flex direction="column" gap="24" class="w-full">
        <!-- Hero Banner Header -->
        <flex direction="column" align="center" justify="center" gap="16" class="w-full p-8 md:p-12 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl shadow-2xl border border-indigo-500/20 relative overflow-hidden text-center">
            <!-- Background Glow Orbs -->
            <div class="absolute -top-24 -left-24 w-72 h-72 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

            <flex direction="row" align="center" gap="8" class="px-3.5 py-1.5 bg-indigo-500/10 border border-indigo-400/30 rounded-full text-indigo-300 font-bold text-xs uppercase tracking-wider backdrop-blur-md">
                <span>⚡ Just XML</span>
            </flex>

            <h1 class="text-3xl md:text-5xl font-black tracking-tight bg-gradient-to-r from-white via-indigo-100 to-blue-200 bg-clip-text text-transparent">
                Vanilla .EUIX Engine
            </h1>

            <p class="max-w-xl text-sm md:text-base text-slate-300 font-medium leading-relaxed">
                State management, REST API calls, variable management, and drag &amp; drop — all handled declaratively inside <span class="text-emerald-400 font-extrabold px-1">Just XML</span> templates with zero Virtual DOM overhead.
            </p>

            <!-- Metrics Pills Grid -->
            <!-- Metrics Pills Grid (2 cols on mobile, 4 on desktop) -->
            <grid cols="4" gap="12" class="w-full max-w-2xl pt-4 border-t border-indigo-500/20 grid grid-cols-2 sm:grid-cols-4">
                <flex direction="column" align="center" class="p-3 bg-white/5 rounded-xl border border-white/10">
                    <span class="text-lg md:text-xl font-black text-emerald-400">&lt; 0.4 ms</span>
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">State Latency</span>
                </flex>
                <flex direction="column" align="center" class="p-3 bg-white/5 rounded-xl border border-white/10">
                    <span class="text-lg md:text-xl font-black text-blue-400">18.7 KB</span>
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Minified Gzip</span>
                </flex>
                <flex direction="column" align="center" class="p-3 bg-white/5 rounded-xl border border-white/10">
                    <span class="text-lg md:text-xl font-black text-amber-400">0 KB</span>
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">VDOM Overhead</span>
                </flex>
                <flex direction="column" align="center" class="p-3 bg-white/5 rounded-xl border border-white/10">
                    <span class="text-lg md:text-xl font-black text-purple-400">100%</span>
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Test Suite</span>
                </flex>
            </grid>

            <!-- Navigation Tabs Bar -->
            <flex direction="row" align="center" justify="center" gap="8" class="pt-6 w-full flex-wrap">
                <button type="button" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-xs rounded-xl transition-all shadow-lg shadow-indigo-600/30 cursor-pointer flex items-center gap-2">
                    <on_click action="SET_STATE">
                        <path>data.active_tab</path>
                        <value>overview</value>
                    </on_click>
                    ✨ Overview &amp; Features
                </button>
                <button type="button" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-extrabold text-xs rounded-xl transition-all border border-slate-700 cursor-pointer flex items-center gap-2">
                    <on_click action="SET_STATE">
                        <path>data.active_tab</path>
                        <value>docs</value>
                    </on_click>
                    📖 Documentation
                </button>
                <button type="button" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-extrabold text-xs rounded-xl transition-all border border-slate-700 cursor-pointer flex items-center gap-2">
                    <on_click action="SET_STATE">
                        <path>data.active_tab</path>
                        <value>benchmarks</value>
                    </on_click>
                    ⚡ Benchmarks
                </button>
                <button type="button" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs rounded-xl transition-all shadow-lg shadow-emerald-600/30 cursor-pointer flex items-center gap-2">
                    <on_click action="SET_STATE">
                        <path>data.active_tab</path>
                        <value>demos</value>
                    </on_click>
                    🎮 Live Demos
                </button>
            </flex>
        </flex>

        <!-- TAB 1: OVERVIEW & CAPABILITIES -->
        <if condition="{data.active_tab} == 'overview'">
            <flex direction="column" gap="16" class="w-full">
                <flex direction="row" align="center" justify="between">
                    <h2 class="text-xl font-black text-slate-800">Framework Capability Matrix</h2>
                    <span class="text-xs text-slate-500 font-medium">Fine-Grained Native DOM Reactivity</span>
                </flex>

                <grid cols="3" gap="16" class="w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3">
                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">🤖</span>
                        <h3 class="font-extrabold text-slate-800 text-base">100% LLM &amp; AI Friendly</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Zero JS boilerplate. Self-describing, machine-readable XML schema allows AI models (ChatGPT, Claude, Gemini) to generate complete, bug-free applications with 100% precision.
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">📄</span>
                        <h3 class="font-extrabold text-slate-800 text-base">Just XML (All-in-One Spec)</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            State management (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;data_model&gt;</code>), REST API calls (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;on_mount action="XHR"&gt;</code>), variable &amp; token management (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;constants&gt;</code>) all handled seamlessly in single XML templates.
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">🌳</span>
                        <h3 class="font-extrabold text-slate-800 text-base">Parent-Child Component Hierarchy</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Modular component architecture with clean <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;component_def&gt;</code> definitions, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;import src="..." /&gt;</code> tags, and smooth parent-to-child prop &amp; reactive state sharing (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">{props.key}</code>).
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">🚀</span>
                        <h3 class="font-extrabold text-slate-800 text-base">Zero Virtual DOM Overhead</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            No heavy VDOM diffing or reconciliation loops. Proxy-based fine-grained reactivity updates target browser DOM nodes directly in-place with &lt;0.4ms latency.
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">📝</span>
                        <h3 class="font-extrabold text-slate-800 text-base">Declarative XML Templates</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Clean, intuitive XML layout tags (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;flex&gt;</code>, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;grid&gt;</code>) and control flow tags (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;if&gt;</code>, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;for_each&gt;</code>).
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">🪝</span>
                        <h3 class="font-extrabold text-slate-800 text-base">Declarative Hooks System</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Lifecycle &amp; state reactivity hooks (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;on_mount&gt;</code>, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;on_unmount&gt;</code>, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;on_state_change&gt;</code>, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;on_interval&gt;</code>) trigger actions when elements mount, unmount, or state changes.
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">🗂️</span>
                        <h3 class="font-extrabold text-slate-800 text-base">Native &amp; Pointer Drag &amp; Drop</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Built-in declarative drag-and-drop (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">draggable="true"</code>, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;on_dragstart&gt;</code>, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;on_drop&gt;</code>) with zero-lag floating previews.
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">📡</span>
                        <h3 class="font-extrabold text-slate-800 text-base">Component-Scoped API Client</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Declarative <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;api_config&gt;</code> with zero-leakage component scoping, interceptors, headers, and SWR revalidation.
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">🎨</span>
                        <h3 class="font-extrabold text-slate-800 text-base">Design Tokens &amp; Constants</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Define reusable utility classes and tokens via <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">&lt;constants&gt;</code> or external JSON files (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">src="..."</code>).
                        </p>
                    </flex>

                    <flex direction="column" gap="8" class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
                        <span class="text-3xl">🛠️</span>
                        <h3 class="font-extrabold text-slate-800 text-base">EUIX DevTools Inspector</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Real-time state tree inspector, action log stream, and interactive console exposure (<code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">$state</code>, <code class="bg-slate-100 px-1 py-0.5 rounded text-blue-600">$engine</code>).
                        </p>
                    </flex>
                </grid>
            </flex>
        </if>

        <!-- TAB 2: DOCUMENTATION REFERENCE -->
        <if condition="{data.active_tab} == 'docs'">
            <grid cols="3" gap="16" class="w-full">
                <!-- Sidebar Menu -->
                <flex direction="column" gap="6" class="p-4 bg-white rounded-2xl border border-slate-200/80 shadow-sm h-fit">
                    <span class="text-xs font-black text-slate-400 uppercase tracking-wider px-2 pb-2 border-b border-slate-100">Doc Topics</span>
                    <button type="button" class="w-full text-left px-3 py-2 rounded-lg font-bold text-xs cursor-pointer transition-colors border border-slate-100 hover:bg-slate-50">
                        <on_click action="SET_STATE">
                            <path>data.active_doc_topic</path>
                            <value>getting_started</value>
                        </on_click>
                        🚀 1. Getting Started
                    </button>
                    <button type="button" class="w-full text-left px-3 py-2 rounded-lg font-bold text-xs cursor-pointer transition-colors border border-slate-100 hover:bg-slate-50">
                        <on_click action="SET_STATE">
                            <path>data.active_doc_topic</path>
                            <value>layout_containers</value>
                        </on_click>
                        📐 2. Layout &amp; Containers
                    </button>
                    <button type="button" class="w-full text-left px-3 py-2 rounded-lg font-bold text-xs cursor-pointer transition-colors border border-slate-100 hover:bg-slate-50">
                        <on_click action="SET_STATE">
                            <path>data.active_doc_topic</path>
                            <value>control_flow</value>
                        </on_click>
                        🔀 3. Control Flow (&lt;if&gt;, &lt;for_each&gt;)
                    </button>
                    <button type="button" class="w-full text-left px-3 py-2 rounded-lg font-bold text-xs cursor-pointer transition-colors border border-slate-100 hover:bg-slate-50">
                        <on_click action="SET_STATE">
                            <path>data.active_doc_topic</path>
                            <value>actions_events</value>
                        </on_click>
                        ⚡ 4. Actions &amp; State Mutations
                    </button>
                    <button type="button" class="w-full text-left px-3 py-2 rounded-lg font-bold text-xs cursor-pointer transition-colors border border-slate-100 hover:bg-slate-50">
                        <on_click action="SET_STATE">
                            <path>data.active_doc_topic</path>
                            <value>drag_drop</value>
                        </on_click>
                        🗂️ 5. Drag &amp; Drop Specification
                    </button>
                    <button type="button" class="w-full text-left px-3 py-2 rounded-lg font-bold text-xs cursor-pointer transition-colors border border-slate-100 hover:bg-slate-50">
                        <on_click action="SET_STATE">
                            <path>data.active_doc_topic</path>
                            <value>hooks</value>
                        </on_click>
                        🪝 6. Declarative Hooks System
                    </button>
                </flex>

                <!-- Doc Detail View (Span 2) -->
                <flex direction="column" gap="12" class="col-span-2 p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm">
                    <if condition="{data.active_doc_topic} == 'getting_started'">
                        <flex direction="column" gap="12">
                            <h3 class="text-lg font-black text-slate-800">🚀 1. Getting Started with EUIX</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                EUIX Engine can be embedded directly inside standard HTML pages using script tags with <code class="bg-slate-100 px-1.5 py-0.5 rounded text-blue-600 font-mono">type="application/euix"</code> or mounted programmatically via JavaScript.
                            </p>
                            <pre class="p-4 bg-slate-900 text-indigo-200 text-xs rounded-xl overflow-x-auto font-mono"><code>&lt;script type="application/euix" target="#app"&gt;
  &lt;uid_spec&gt;
    &lt;data_model&gt;
      &lt;state id="counter"&gt;0&lt;/state&gt;
    &lt;/data_model&gt;
    &lt;flex direction="column" gap="12"&gt;
      &lt;span&gt;Count: {data.counter}&lt;/span&gt;
      &lt;button&gt;
        &lt;on_click action="SET_STATE"&gt;
          &lt;path&gt;data.counter&lt;/path&gt;
          &lt;value&gt;{data.counter + 1}&lt;/value&gt;
        &lt;/on_click&gt;
        Increment
      &lt;/button&gt;
    &lt;/flex&gt;
  &lt;/uid_spec&gt;
&lt;/script&gt;</code></pre>
                        </flex>
                    </if>

                    <if condition="{data.active_doc_topic} == 'layout_containers'">
                        <flex direction="column" gap="12">
                            <h3 class="text-lg font-black text-slate-800">📐 2. Layout &amp; Container Tags</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                EUIX includes native layout tags mapped to CSS Flexbox and Grid engines:
                            </p>
                            <ul class="text-xs text-slate-600 space-y-2 list-disc pl-4">
                                <li><strong class="text-slate-800">&lt;flex&gt;</strong>: Attributes <code class="bg-slate-100 px-1 text-blue-600">direction="row|column"</code>, <code class="bg-slate-100 px-1 text-blue-600">align="center|start|end"</code>, <code class="bg-slate-100 px-1 text-blue-600">justify="between|center"</code>, <code class="bg-slate-100 px-1 text-blue-600">gap="16"</code>.</li>
                                <li><strong class="text-slate-800">&lt;grid&gt;</strong>: Attributes <code class="bg-slate-100 px-1 text-blue-600">cols="2|3|4"</code>, <code class="bg-slate-100 px-1 text-blue-600">gap="12"</code>.</li>
                                <li><strong class="text-slate-800">&lt;collapse&gt;</strong>: Collapsible drawer with <code class="bg-slate-100 px-1 text-blue-600">bind="data.open"</code>.</li>
                            </ul>
                        </flex>
                    </if>

                    <if condition="{data.active_doc_topic} == 'control_flow'">
                        <flex direction="column" gap="12">
                            <h3 class="text-lg font-black text-slate-800">🔀 3. Logic &amp; Control Flow Tags</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Declarative conditional rendering and dynamic list iteration:
                            </p>
                            <pre class="p-4 bg-slate-900 text-indigo-200 text-xs rounded-xl overflow-x-auto font-mono"><code>&lt;if condition="{data.user.role} == admin"&gt;
  &lt;span&gt;Admin Dashboard&lt;/span&gt;
  &lt;else&gt;
    &lt;span&gt;Guest View&lt;/span&gt;
  &lt;/else&gt;
&lt;/if&gt;

&lt;for_each items="{data.tasks}" var="task"&gt;
  &lt;span&gt;{task.title}&lt;/span&gt;
&lt;/for_each&gt;</code></pre>
                        </flex>
                    </if>

                    <if condition="{data.active_doc_topic} == 'actions_events'">
                        <flex direction="column" gap="12">
                            <h3 class="text-lg font-black text-slate-800">⚡ 4. Actions &amp; State Mutations</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                EUIX features rich declarative action listeners:
                            </p>
                            <ul class="text-xs text-slate-600 space-y-2 list-disc pl-4">
                                <li><strong class="text-slate-800">SET_STATE</strong>: Updates state value (<code class="bg-slate-100 px-1 text-blue-600">&lt;path&gt;</code>, <code class="bg-slate-100 px-1 text-blue-600">&lt;value&gt;</code>).</li>
                                <li><strong class="text-slate-800">MUTATE_STATE</strong>: Array operations (<code class="bg-slate-100 px-1 text-blue-600">PUSH</code>, <code class="bg-slate-100 px-1 text-blue-600">REMOVE</code>, <code class="bg-slate-100 px-1 text-blue-600">SWAP</code>, <code class="bg-slate-100 px-1 text-blue-600">INCREMENT</code>, <code class="bg-slate-100 px-1 text-blue-600">DECREMENT</code>, <code class="bg-slate-100 px-1 text-blue-600">MOVE_UP</code>, <code class="bg-slate-100 px-1 text-blue-600">MOVE_DOWN</code>).</li>
                                <li><strong class="text-slate-800">XHR / REVALIDATE_API</strong>: Async HTTP requests &amp; SWR background refetching.</li>
                            </ul>
                        </flex>
                    </if>

                    <if condition="{data.active_doc_topic} == 'drag_drop'">
                        <flex direction="column" gap="12">
                            <h3 class="text-lg font-black text-slate-800">🗂️ 5. Drag &amp; Drop Specification</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                HTML5 &amp; Pointer Drag and Drop with zero-lag floating drag previews:
                            </p>
                            <pre class="p-4 bg-slate-900 text-indigo-200 text-xs rounded-xl overflow-x-auto font-mono"><code>&lt;div draggable="true" data-id="{item.id}"&gt;
  &lt;on_dragstart action="SET_STATE"&gt;
    &lt;path&gt;data.dragged_id&lt;/path&gt;
    &lt;value&gt;{item.id}&lt;/value&gt;
  &lt;/on_dragstart&gt;
  &lt;on_drop action="MUTATE_STATE" operation="SWAP"&gt;
    &lt;path&gt;data.items&lt;/path&gt;
    &lt;where equals="{data.dragged_id}" /&gt;
    &lt;target_where equals="{item.id}" /&gt;
  &lt;/on_drop&gt;
&lt;/div&gt;</code></pre>
                        </flex>
                    </if>

                    <if condition="{data.active_doc_topic} == 'hooks'">
                        <flex direction="column" gap="12">
                            <h3 class="text-lg font-black text-slate-800">🪝 6. Declarative Hooks System</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                EUIX provides rich declarative lifecycle and state observation hooks directly inside XML:
                            </p>
                            <ul class="text-xs text-slate-600 space-y-2 list-disc pl-4">
                                <li><strong class="text-slate-800">&lt;on_mount&gt;</strong>: Executes when element mounts. Commonly used for XHR REST data fetching (<code class="bg-slate-100 px-1 text-blue-600">&lt;on_mount action="XHR"&gt;</code>).</li>
                                <li><strong class="text-slate-800">&lt;on_unmount&gt;</strong>: Executes automatically when element is unmounted or removed from DOM tree.</li>
                                <li><strong class="text-slate-800">&lt;on_state_change&gt;</strong>: Watches state key (<code class="bg-slate-100 px-1 text-blue-600">watch="data.counter"</code>) and triggers actions on change.</li>
                                <li><strong class="text-slate-800">&lt;on_interval&gt;</strong>: Declarative timer hook running every N milliseconds (<code class="bg-slate-100 px-1 text-blue-600">ms="1000"</code>).</li>
                            </ul>
                            <pre class="p-4 bg-slate-900 text-indigo-200 text-xs rounded-xl overflow-x-auto font-mono"><code>&lt;!-- State Watcher Hook --&gt;
&lt;on_state_change watch="data.counter" action="SET_STATE"&gt;
  &lt;path&gt;data.log&lt;/path&gt;
  &lt;value&gt;Counter updated to {data.counter}&lt;/value&gt;
&lt;/on_state_change&gt;

&lt;!-- Recurring Timer Hook --&gt;
&lt;on_interval ms="1000" action="SET_STATE"&gt;
  &lt;path&gt;data.seconds&lt;/path&gt;
  &lt;value&gt;{data.seconds + 1}&lt;/value&gt;
&lt;/on_interval&gt;</code></pre>
                        </flex>
                    </if>
